--TEST--
001: IF(SHR(X, C)) => IF(AND(X, MASK)) keeps a signed MASK sign extended
--ARGS--
-O2 --save
--CODE--
{
	int32_t c_1 = 4;
	int32_t c_2 = -16;
	l_1 = START(l_6);
	int32_t d_2 = PARAM(l_1, "x", 1);
	int32_t d_3 = SHR(d_2, c_1);
	l_2 = IF(l_1, d_3);
	l_3 = IF_TRUE(l_2);
	l_4 = RETURN(l_3, c_2);
	l_5 = IF_FALSE(l_2);
	l_6 = RETURN(l_5, d_2, l_4);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = -16;
	l_1 = START(l_8);
	int32_t d_2 = PARAM(l_1, "x", 1);
	int32_t d_3 = AND(d_2, c_4);
	l_4 = IF(l_1, d_3);
	l_5 = IF_TRUE(l_4);
	l_6 = RETURN(l_5, c_4);
	l_7 = IF_FALSE(l_4);
	l_8 = RETURN(l_7, d_2, l_6);
}
