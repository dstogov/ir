--TEST--
004: min function
--TARGET--
x86
--ARGS--
-S -mavx
--CODE--
{
	l_1 = START(l_4);
	double x = PARAM(l_1, "x", 1);
	double y = PARAM(l_1, "y", 2);
	double ret = MIN(x, y);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
test:
	subl $8, %esp
	vmovsd 0xc(%esp), %xmm0
	vmovsd 0x14(%esp), %xmm1
	vminsd %xmm0, %xmm1, %xmm2
	vcmpordsd %xmm0, %xmm0, %xmm3
	vblendvpd %xmm3, %xmm2, %xmm1, %xmm2
	vmovsd %xmm2, (%esp)
	fldl (%esp)
	addl $8, %esp
	retl
