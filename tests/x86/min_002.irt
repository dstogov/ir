--TEST--
002: min function
--TARGET--
x86
--ARGS--
-S -mavx
--CODE--
{
	l_1 = START(l_4);
	float x = PARAM(l_1, "x", 1);
	float y = PARAM(l_1, "y", 2);
	float ret = MIN(x, y);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
test:
	subl $4, %esp
	vmovss 8(%esp), %xmm0
	vmovss 0xc(%esp), %xmm1
	vminss %xmm0, %xmm1, %xmm2
	vcmpordss %xmm0, %xmm0, %xmm3
	vblendvps %xmm3, %xmm2, %xmm1, %xmm2
	vmovss %xmm2, (%esp)
	flds (%esp)
	addl $4, %esp
	retl
