--CODE--
func thread_pointer(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(-1, 0);
	l_4 = RETURN(l_1, ret);
}
func tls_addr_static(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(-1, 16);
	l_4 = RETURN(l_1, ret);
}
