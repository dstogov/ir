--TEST--
001: TLS_ADDR
--TARGET--
x86-windows
--ARGS--
-S
--CODE--
func thread_pointer(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(-1, 0);
	l_4 = RETURN(l_1, ret);
}
func tls_addr_static(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(-1, 16);
	l_4 = RETURN(l_1, ret);
}
func tls_addr_dynamic0(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(16, 0);
	l_4 = RETURN(l_1, ret);
}
func tls_addr_dynamic(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(16, 32);
	l_4 = RETURN(l_1, ret);
}
func tls_load_static(): int32_t
{
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(-1, 16);
	int32_t ret, l_2 = LOAD(l_1, addr);
	l_4 = RETURN(l_2, ret);
}
func tls_load_dynamic(): int32_t
{
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(16, 32);
	int32_t ret, l_2 = LOAD(l_1, addr);
	l_4 = RETURN(l_2, ret);
}
func tls_store_static(): void
{
	int32_t val = 42;
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(-1, 16);
	l_2 = STORE(l_1, addr, val);
	l_4 = RETURN(l_2);
}
func tls_store_dynamic(): void
{
	int32_t val = 42;
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(16, 32);
	l_2 = STORE(l_1, addr, val);
	l_4 = RETURN(l_2);
}
--EXPECT--
thread_pointer:
	movl %fs:0, %eax
	retl

tls_addr_static:
	movl %fs:0, %eax
	addl $0x10, %eax
	retl

tls_addr_dynamic0:
	movl %fs:0x2c, %eax
	movl 0x10(%eax), %eax
	retl

tls_addr_dynamic:
	movl %fs:0x2c, %eax
	movl 0x10(%eax), %eax
	addl $0x20, %eax
	retl

tls_load_static:
	movl %fs:0x10, %eax
	retl

tls_load_dynamic:
	movl %fs:0x2c, %eax
	movl 0x10(%eax), %eax
	movl 0x20(%eax), %eax
	retl

tls_store_static:
	movl $0x2a, %fs:0x10
	retl

tls_store_dynamic:
	movl %fs:0x2c, %eax
	movl 0x10(%eax), %eax
	movl $0x2a, 0x20(%eax)
	retl
