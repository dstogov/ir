--TEST--
001: TLS_ADDR
--TARGET--
x86-*-sysv
--ARGS--
-S
--CODE--
func thread_pointer(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret, l_2 = TLS_ADDR(l_1, -1, 0);
	l_4 = RETURN(l_2, ret);
}
func tls_addr_static(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret, l_2 = TLS_ADDR(l_1, -1, 16);
	l_4 = RETURN(l_2, ret);
}
func tls_addr_dynamic0(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret, l_2 = TLS_ADDR(l_1, 16, 0);
	l_4 = RETURN(l_2, ret);
}
func tls_addr_dynamic(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret, l_2 = TLS_ADDR(l_1, 16, 32);
	l_4 = RETURN(l_2, ret);
}
func tls_load_static(): int32_t
{
	l_1 = START(l_4);
	uintptr_t addr, l_2 = TLS_ADDR(l_1, -1, 16);
	int32_t ret, l_3 = LOAD(l_2, addr);
	l_4 = RETURN(l_3, ret);
}
func tls_load_dynamic(): int32_t
{
	l_1 = START(l_4);
	uintptr_t addr, l_2 = TLS_ADDR(l_1, 16, 32);
	int32_t ret, l_3 = LOAD(l_2, addr);
	l_4 = RETURN(l_3, ret);
}
func tls_store_static(): void
{
	int32_t val = 42;
	l_1 = START(l_4);
	uintptr_t addr, l_2 = TLS_ADDR(l_1, -1, 16);
	l_3 = STORE(l_2, addr, val);
	l_4 = RETURN(l_3);
}
func tls_store_dynamic(): void
{
	int32_t val = 42;
	l_1 = START(l_4);
	uintptr_t addr, l_2 = TLS_ADDR(l_1, 16, 32);
	l_3 = STORE(l_2, addr, val);
	l_4 = RETURN(l_3);
}
--EXPECT--
thread_pointer:
	movl %gs:0, %eax
	retl

tls_addr_static:
	movl %gs:0, %eax
	addl $0x10, %eax
	retl

tls_addr_dynamic0:
	movl %gs:4, %eax
	movl 0x10(%eax), %eax
	retl

tls_addr_dynamic:
	movl %gs:4, %eax
	movl 0x10(%eax), %eax
	addl $0x20, %eax
	retl

tls_load_static:
	movl %gs:0x10, %eax
	retl

tls_load_dynamic:
	movl %gs:4, %eax
	movl 0x10(%eax), %eax
	movl 0x20(%eax), %eax
	retl

tls_store_static:
	movl $0x2a, %gs:0x10
	retl

tls_store_dynamic:
	movl %gs:4, %eax
	movl 0x10(%eax), %eax
	movl $0x2a, 0x20(%eax)
	retl
