--TEST--
001: min function
--TARGET--
x86
--ARGS--
-S
--CODE--
{
	l_1 = START(l_4);
	float x = PARAM(l_1, "x", 1);
	float y = PARAM(l_1, "y", 2);
	float ret = MIN(x, y);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
test:
	subl $4, %esp
	movss 8(%esp), %xmm0
	movss 0xc(%esp), %xmm1
	movaps %xmm1, %xmm2
	minss %xmm0, %xmm2
	movaps %xmm0, %xmm3
	cmpordss %xmm3, %xmm3
	andps %xmm3, %xmm2
	andnps %xmm1, %xmm3
	orps %xmm3, %xmm2
	movss %xmm2, (%esp)
	flds (%esp)
	addl $4, %esp
	retl
