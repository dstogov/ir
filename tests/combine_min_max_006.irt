--TEST--
006: Combine MIN/MAX with adjusted constant keeps shared compare
--ARGS--
--save
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint32_t c_4 = 3;
	uint32_t c_5 = 4;
	l_1 = START(l_9);
	uint32_t x = PARAM(l_1, "x", 1);
	bool c = ULE(x, c_4);
	l_2 = IF(l_1, c);
	l_3 = IF_TRUE(l_2);
	l_4 = END(l_3);
	l_5 = IF_FALSE(l_2);
	l_6 = END(l_5);
	l_7 = MERGE(l_4, l_6);
	uint32_t p = PHI(l_7, c_5, x);
	uint32_t z = ZEXT(c);
	uint32_t r = ADD(p, z);
	l_9 = RETURN(l_7, r);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint32_t c_4 = 3;
	uint32_t c_5 = 4;
	l_1 = START(l_7);
	uint32_t d_2 = PARAM(l_1, "x", 1);
	bool d_3 = ULE(d_2, c_4);
	uint32_t d_4 = MAX(d_2, c_5);
	uint32_t d_5 = ZEXT(d_3);
	uint32_t d_6 = ADD(d_5, d_4);
	l_7 = RETURN(l_1, d_6);
}
