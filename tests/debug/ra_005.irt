--TEST--
005: Register Allocation (allocate %rcx for vreg used as SHIFT.op2 and alive after the SHIFT)
--TARGET--
x86_64-*-sysv
--ARGS--
-S
--CODE--
{
	l_1 = START(l_5);
	uintptr_t v = PARAM(l_1, "ptr", 1);
	int32_t z1 = PARAM(l_1, "z1", 2);
	int32_t z2 = PARAM(l_1, "z2", 3);
	int32_t y = PARAM(l_1, "y", 4);
	int32_t z, l_3 = LOAD(l_1, v);
	int32_t ret = SHL(z, y);
	l_4 = STORE(l_3, v, ret);
	l_5 = RETURN(l_4, y);
}
--EXPECT--
test:
	shll %cl, (%rdi)
	movl %ecx, %eax
	retq
