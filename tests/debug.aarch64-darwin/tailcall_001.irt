--TEST--
Simple CALL
--TARGET--
aarch64-darwin
--ARGS--
-S --run
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 42;
	uintptr_t c_5 = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_6 = "hello %d!\n";
	l_1 = START(l_4);
	char d_2, l_2 = TAILCALL/2(l_1, c_5, c_6, c_4);
	l_4 = UNREACHABLE(l_2);
}
--EXPECT--
main:
	stp x29, x30, [sp, #-0x10]!
	mov x29, sp
	sub sp, sp, #0x10
	adr x0, .L1
	movz w16, #0x2a
	str x16, [sp]
	bl printf
	add sp, sp, #0x10
	ldp x29, x30, [sp], #0x10
	ret
.rodata
.L1:
	.db 0x68, 0x65, 0x6c, 0x6c, 0x6f, 0x20, 0x25, 0x64, 0x21, 0x0a, 0x00, 0x00

hello 42!

exit code = 10
