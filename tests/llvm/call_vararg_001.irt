--TEST--
001: vararg call without fixed parameters
--CODE--
{
	int32_t c_1 = 42;
	uintptr_t c_2 = func foo(...): int32_t;
	l_1 = START(l_3);
	int32_t d_2, l_2 = CALL/1(l_1, c_2, c_1);
	l_3 = RETURN(l_2, d_2);
}
--EXPECT--
define i32 @test()
{
	%d2 = call i32 (...) @foo(i32 42)
	ret i32 %d2
}
declare i32 @foo(...)
