--TEST--
001: Infinity and NaN constants
--ARGS--
--emit-llvm
--CODE--
extern func @test_d(double, double, double, double, double, double): void;
extern func @test_f(float, float, float, float, float, float): void;
func @main(): int32_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uintptr_t c_4 = func @test_d(double, double, double, double, double, double): void;
	double c_5 = nan;
	double c_6 = nan;
	double c_7 = -inf;
	double c_8 = inf;
	double c_9 = -0;
	double c_10 = 0;
	uintptr_t c_11 = func @test_f(float, float, float, float, float, float): void;
	float c_12 = nan;
	float c_13 = nan;
	float c_14 = -inf;
	float c_15 = inf;
	float c_16 = -0;
	float c_17 = 0;
	int32_t c_18 = 0;
#BB1: end=l_8
	l_1 = START(l_8);
	l_2 = CALL/6(l_1, c_4, c_5, c_6, c_7, c_8, c_9, c_10);
	l_5 = CALL/6(l_2, c_11, c_12, c_13, c_14, c_15, c_16, c_17);
	l_8 = RETURN(l_5, c_18);
}
--EXPECT--
declare void @test_d(double, double, double, double, double, double)
declare void @test_f(float, float, float, float, float, float)
define i32 @main()
{
	call void @test_d(double 0x7ff8000000000000, double 0x7ff8000000000000, double 0xfff0000000000000, double 0x7ff0000000000000, double -0.0, double 0.0)
	call void @test_f(float 0x7ff8000000000000, float 0x7ff8000000000000, float 0xfff0000000000000, float 0x7ff0000000000000, float -0.0, float 0.0)
	ret i32 0
}
