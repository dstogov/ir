--TEST--
002: cond function (int32_t condition)
--ARGS--
--emit-llvm
--CODE--
{
	l_1 = START(l_4);
	int32_t x = PARAM(l_1, "x", 1);
	int32_t y = PARAM(l_1, "y", 2);
	int32_t z = PARAM(l_1, "z", 3);
	int32_t ret = COND(z, x, y);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
define i32 @test(i32 %d2, i32 %d3, i32 %d4)
{
	%t5 = icmp ne i32 %d4, 0
	%d5 = select i1 %t5, i32 %d2, i32 %d3
	ret i32 %d5
}
