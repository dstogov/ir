--TEST--
001: constant function address tailcall emits a typed function pointer
--ARGS--
--emit-llvm
--CODE--
{
	uintptr_t c_1 = func *0x1234(void): int32_t;
	l_1 = START(l_3);
	int32_t d_2, l_2 = TAILCALL(l_1, c_1);
	l_3 = UNREACHABLE(l_2);
}
--EXPECT--
define i32 @test()
{
	%d2 = tail call i32 inttoptr (i64 u0x1234 to ptr)()
	ret i32 %d2
}
