--TEST--
001: VAR/VSTORE_v/VLOAD_v
--CODE--
{
	l_1 = START(l_6);
	int32_t d_2 = PARAM(l_1, "x", 0);
	int32_t d_3 = VAR(l_1, "y");
	l_4 = VSTORE_v(l_1, d_3, d_2);
	int32_t d_5, l_5 = VLOAD_v(l_4, d_3);
	l_6 = RETURN(l_5, d_5);
}
--EXPECT--
define i32 @test(i32 %d2)
{
	%d3 = alloca i32
	store volatile i32 %d2, ptr %d3
	%d5 = load volatile i32, ptr %d3
	ret i32 %d5
}
