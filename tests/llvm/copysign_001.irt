--TEST--
001: builtin copysign (double)
--ARGS--
--emit-llvm
--CODE--
{
	uintptr_t c_1 = func copysign(double, double): double __builtin;
	l_1 = START(l_4);
	double x = PARAM(l_1, "x", 1);
	double y = PARAM(l_1, "y", 2);
	double d_4, l_2 = CALL/2(l_1, c_1, x, y);
	l_4 = RETURN(l_2, d_4);
}
--EXPECT--
define double @test(double %d2, double %d3)
{
	%d4 = call double @llvm.copysign.f64(double %d2, double %d3)
	ret double %d4
}
declare double @llvm.copysign.f64(double, double)
