--TEST--
001: proto-backed vararg call emits the fixed parameter types
--CODE--
{
	int32_t c_1 = 42;
	uintptr_t c_2 = "hello %d!\n";
	l_1 = START(l_5);
	uintptr_t d_2 = PARAM(l_1, "p", 1);
	uintptr_t d_3 = PROTO(d_2, func(uintptr_t, ...): int32_t);
	int32_t d_4, l_4 = CALL/2(l_1, d_3, c_2, c_1);
	l_5 = RETURN(l_4, d_4);
}
--EXPECT--
define i32 @test(ptr %d2)
{
	%d3 = bitcast ptr %d2 to ptr
	%d4 = call i32 (ptr, ...) %d3(ptr @.str5, i32 42)
	ret i32 %d4
}
@.str5 = private unnamed_addr constant [11 x i8] c"hello %d!\0A\00"
