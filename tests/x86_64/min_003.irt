--TEST--
003: min function
--TARGET--
x86_64-*-sysv
--ARGS--
-S
--CODE--
{
	l_1 = START(l_4);
	double x = PARAM(l_1, "x", 1);
	double y = PARAM(l_1, "y", 2);
	double ret = MIN(x, y);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
test:
	movapd %xmm1, %xmm2
	minsd %xmm0, %xmm2
	movapd %xmm0, %xmm3
	cmpordsd %xmm3, %xmm3
	andpd %xmm3, %xmm2
	andnpd %xmm1, %xmm3
	orpd %xmm3, %xmm2
	movapd %xmm2, %xmm0
	retq
