--TEST--
TLS_ADDR stored as a value
--TARGET--
x86_64-linux-sysv
--ARGS--
-O2 -S
--CODE--
func store_address_to_itself(): void
{
	l_1 = START(l_3);
	uintptr_t a = TLS_ADDR(-1, 24);
	l_2 = STORE(l_1, a, a);
	l_3 = RETURN(l_2);
}
func load_and_escape_address(uintptr_t): int32_t
{
	l_1 = START(l_4);
	uintptr_t out = PARAM(l_1, "out", 1);
	uintptr_t a = TLS_ADDR(-1, 24);
	int32_t value, l_2 = LOAD_v(l_1, a);
	l_3 = STORE(l_2, out, a);
	l_4 = RETURN(l_3, value);
}
--EXPECT--
store_address_to_itself:
	movq %fs:0, %rax
	addq $0x18, %rax
	movq %rax, (%rax)
	retq

load_and_escape_address:
	movq %fs:0, %rcx
	addq $0x18, %rcx
	movl (%rcx), %eax
	movq %rcx, (%rdi)
	retq
