{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 10;
	l_1 = START(l_4);
	int32_t d_2 = PARAM(l_1, "x", 0);
	int32_t d_3 = DIV(d_2, c_4);
	l_4 = RETURN(l_1, d_3);
}
func test2(int32_t): void
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
