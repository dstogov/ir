--TEST--
Abort on data instruction definition with two results
--ARGS--
--run
--CODE--
func main(int32_t): int32_t
{
	l_1 = START(l_3);
	int32_t x = PARAM(l_1, "x", 1);
	int32_t d_2, l_2 = ADD(x, x);
	int32_t r = 0;
	l_3 = RETURN(l_1, r);
}
--EXPECT--
ERROR: instruction ADD provides a single output at line 5

exit code = 2
