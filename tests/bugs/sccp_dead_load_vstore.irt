--TEST--
SCCP: requeue LOAD after removing an overwritten VSTORE
--ARGS--
-O2 -fno-mem2ssa --save
--CODE--
{
	uint64_t c_42 = 42;
	l_1 = START(l_ret);
	uintptr_t src = PARAM(l_1, "src", 0);
	uintptr_t dst = PARAM(l_1, "dst", 1);
	uint64_t v = VAR(l_1, "v");
	uint64_t copy = COPY(later);
	uint64_t value, l_load = LOAD(l_1, src);
	l_store = VSTORE(l_load, v, value);
	l_overwrite = VSTORE(l_store, v, copy);
	uint64_t later = COPY(c_42);
	l_ret = RETURN(l_overwrite);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint64_t c_4 = 42;
	l_1 = START(l_6);
	uintptr_t d_2 = PARAM(l_1, "src", 0);
	uintptr_t d_3 = PARAM(l_1, "dst", 1);
	uint64_t d_4 = VAR(l_1, "v");
	l_5 = VSTORE(l_1, d_4, c_4);
	l_6 = RETURN(l_5, null);
}
