--TEST--
SCCP: requeue LOAD_v after pruning an infeasible PHI input
--ARGS--
-O2 -fno-mem2ssa --save
--CODE--
{
	bool c_true = 1;
	int32_t c_11 = 11;
	int32_t c_22 = 22;
	l_1 = START(l_ret);
	uintptr_t src = PARAM(l_1, "src", 0);
	bool choose = PARAM(l_1, "choose", 1);
	bool condition = COPY(later);
	int32_t value, l_load = LOAD_v(l_1, src);
	l_if = IF(l_load, condition);
	l_false = IF_FALSE(l_if);
	l_end0 = END(l_false);
	l_true = IF_TRUE(l_if);
	l_if2 = IF(l_true, choose);
	l_left = IF_TRUE(l_if2);
	l_end1 = END(l_left);
	l_right = IF_FALSE(l_if2);
	l_end2 = END(l_right);
	l_merge = MERGE/3(l_end0, l_end1, l_end2);
	int32_t result = PHI/3(l_merge, value, c_11, c_22);
	bool later = COPY(c_true);
	l_ret = RETURN(l_merge, result);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 11;
	int32_t c_5 = 22;
	l_1 = START(l_5);
	uintptr_t d_2 = PARAM(l_1, "src", 0);
	bool d_3 = PARAM(l_1, "choose", 1);
	int32_t d_4 = COND(d_3, c_4, c_5);
	l_5 = RETURN(l_1, d_4);
}
