--TEST--
Save address-vector constants without losing their type or values
--ARGS--
-O0 --save
--CODE--
{
	<uintptr_t*1> c_4 = {4294967295};
	<uintptr_t*2> c_5 = {4294967295, 2147483647};
	l_1 = START(l_2);
	l_2 = RETURN(l_1);
}
--EXPECT--
{
	<uintptr_t*2> c_7 = {4294967295, 2147483647};
	<uintptr_t*1> c_5 = {4294967295};
	bool c_3 = 1;
	bool c_2 = 0;
	uintptr_t c_1 = 0;
	l_1 = START(l_2);
	l_2 = RETURN(l_1, null);
}
