	l_4 = MERGE(l_9, l_11);
	l_5 = RETURN(l_4, c_1);
	l_6 = CASE_DEFAULT(l_3);
	l_7 = RETURN(l_6, c_0, l_5);
	l_8 = CASE_VAL(l_3, c_0);
	l_9 = END(l_8);
	l_10 = CASE_VAL(l_3, c_1);
	l_11 = END(l_10);
}
