--TEST--
GH-339: dominators for a MERGE placed before all its predecessors
--ARGS--
-O1 -fno-mem2ssa --save-cfg --save-ir-after-dom
--CODE--
{
	int32_t c_0 = 0;
	int32_t c_1 = 1;
