--TEST--
SCCP: requeue LOAD_v after removing an overwritten STORE
--ARGS--
-O2 -fno-mem2ssa --save
--CODE--
{
	uint64_t c_42 = 42;
	l_1 = START(l_ret);
	uintptr_t src = PARAM(l_1, "src", 0);
	uintptr_t dst = PARAM(l_1, "dst", 1);
	uint64_t copy = COPY(later);
	uint64_t value, l_load = LOAD_v(l_1, src);
	l_store = STORE(l_load, dst, value);
	l_overwrite = STORE(l_store, dst, copy);
	uint64_t later = COPY(c_42);
	l_ret = RETURN(l_overwrite);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint64_t c_4 = 42;
	l_1 = START(l_5);
	uintptr_t d_2 = PARAM(l_1, "src", 0);
	uintptr_t d_3 = PARAM(l_1, "dst", 1);
	l_4 = STORE(l_1, d_3, c_4);
	l_5 = RETURN(l_4, null);
}
