--TEST--
Abort on floating-point literal in an integer vector constant
--ARGS--
--run
--CODE--
func main(): int32_t
{
	<int16_t * 8> c = {1, 2.0};
	int32_t r = 0;
	l_1 = START(l_2);
	l_2 = RETURN(l_1, r);
}
--EXPECT--
ERROR: floating-point constant is incompatible with int16_t at line 3

exit code = 2
