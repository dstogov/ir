--TEST--
NOT(NOT(x)) is folded into NE(x, 0) for boolean NOT of non-boolean x
--CODE--
{
	l_1 = START(l_4);
	int32_t d_2 = PARAM(l_1, "x", 1);
	bool d_3 = NOT(d_2);
	bool d_4 = NOT(d_3);
	l_4 = RETURN(l_1, d_4);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 0;
	l_1 = START(l_4);
	int32_t d_2 = PARAM(l_1, "x", 1);
	bool d_3 = NE(d_2, c_4);
	l_4 = RETURN(l_1, d_3);
}
