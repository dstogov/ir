--TEST--
022: FOLD: AND(AND(X, Y), X) and AND(AND(X, Y), Y) fold to AND(X, Y)
--ARGS--
-O2 --save
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	l_1 = START(l_7);
	int32_t d_2 = PARAM(l_1, "a", 1);
	int32_t d_3 = PARAM(l_1, "b", 2);
	uintptr_t d_4 = PARAM(l_1, "p", 3);
	int32_t d_5 = AND(d_2, d_3);
	int32_t d_6 = AND(d_5, d_2);
	int32_t d_8 = AND(d_5, d_3);
	l_9 = STORE(l_1, d_4, d_6);
	l_10 = STORE(l_9, d_4, d_8);
	l_7 = RETURN(l_10);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	l_1 = START(l_7);
	int32_t d_2 = PARAM(l_1, "a", 1);
	int32_t d_3 = PARAM(l_1, "b", 2);
	uintptr_t d_4 = PARAM(l_1, "p", 3);
	int32_t d_5 = AND(d_3, d_2);
	l_6 = STORE(l_1, d_4, d_5);
	l_7 = RETURN(l_6, null);
}
