--TEST--
041: FOLD: CMP(SEXT(x), C) sign-extends an unsigned constant from the compare width
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint32_t c_4 = 4294967280;
	uint32_t c_5 = 4294901760;
	l_1 = START(l_8);
	int8_t d_2 = PARAM(l_1, "x", 1);
	uint32_t d_3 = SEXT(d_2);
	bool d_4 = EQ(d_3, c_4);
	uint32_t d_5 = SEXT(d_2);
	bool d_6 = LT(d_5, c_5);
	bool d_7 = OR(d_4, d_6);
	l_8 = RETURN(l_1, d_7);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int8_t c_4 = -16;
	l_1 = START(l_4);
	int8_t d_2 = PARAM(l_1, "x", 1);
	bool d_3 = EQ(d_2, c_4);
	l_4 = RETURN(l_1, d_3);
}
