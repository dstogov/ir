--TEST--
028: FOLD: (x >>s 4) & 0xff is not turned into SHR
--ARGS--
-O2 --save
--CODE--
{
	int64_t c_1 = 4;
	int64_t c_2 = 255;
	l_1 = START(l_8);
	int64_t d_2 = PARAM(l_1, "x", 1);
	int64_t d_4 = SAR(d_2, c_1);
	int64_t d_5 = AND(d_4, c_2);
	l_8 = RETURN(l_1, d_5);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int64_t c_4 = 4;
	int64_t c_5 = 255;
	l_1 = START(l_5);
	int64_t d_2 = PARAM(l_1, "x", 1);
	int64_t d_3 = SAR(d_2, c_4);
	int64_t d_4 = AND(d_3, c_5);
	l_5 = RETURN(l_1, d_4);
}
