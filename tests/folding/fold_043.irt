--TEST--
043: FOLD: CTLZ(ZEXT(x)) - c is not folded for bool x or a mismatched c
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint32_t c_4 = 31;
	uint32_t c_5 = 8;
	l_1 = START(l_11);
	bool d_2 = PARAM(l_1, "a", 1);
	uint16_t d_3 = PARAM(l_1, "c", 2);
	uint32_t d_4 = ZEXT(d_2);
	uint32_t d_5 = CTLZ(d_4);
	uint32_t d_6 = SUB(d_5, c_4);
	uint32_t d_7 = ZEXT(d_3);
	uint32_t d_8 = CTLZ(d_7);
	uint32_t d_9 = SUB(d_8, c_5);
	uint32_t d_10 = ADD(d_6, d_9);
	l_11 = RETURN(l_1, d_10);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint32_t c_4 = 31;
	uint32_t c_5 = 8;
	l_1 = START(l_11);
	bool d_2 = PARAM(l_1, "a", 1);
	uint16_t d_3 = PARAM(l_1, "c", 2);
	uint32_t d_4 = ZEXT(d_2);
	uint32_t d_5 = CTLZ(d_4);
	uint32_t d_6 = SUB(d_5, c_4);
	uint32_t d_7 = ZEXT(d_3);
	uint32_t d_8 = CTLZ(d_7);
	uint32_t d_9 = SUB(d_8, c_5);
	uint32_t d_10 = ADD(d_9, d_6);
	l_11 = RETURN(l_1, d_10);
}
