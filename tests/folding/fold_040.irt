--TEST--
040: FOLD: (x - c1) + c2 => x + (c2 - c1) does not negate INT8_MIN
--ARGS--
-O2 --save
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int8_t c_4 = -28;
	int8_t c_5 = 100;
	l_1 = START(l_5);
	int8_t d_2 = PARAM(l_1, "x", 1);
	int8_t d_3 = SUB(d_2, c_5);
	int8_t d_4 = ADD(d_3, c_4);
	l_5 = RETURN(l_1, d_4);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int8_t c_4 = -128;
	l_1 = START(l_4);
	int8_t d_2 = PARAM(l_1, "x", 1);
	int8_t d_3 = ADD(d_2, c_4);
	l_4 = RETURN(l_1, d_3);
}
