--TEST--
026: FOLD: (x << 3) | ((x >>s 61) & 7) => ROL(x, 3)
--ARGS--
-O2 --save
--CODE--
{
	int64_t c_1 = 3;
	int64_t c_2 = 61;
	int64_t c_3 = 7;
	l_1 = START(l_8);
	int64_t d_2 = PARAM(l_1, "x", 1);
	int64_t d_3 = SHL(d_2, c_1);
	int64_t d_4 = SAR(d_2, c_2);
	int64_t d_5 = AND(d_4, c_3);
	int64_t d_6 = OR(d_3, d_5);
	l_8 = RETURN(l_1, d_6);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int64_t c_4 = 3;
	l_1 = START(l_4);
	int64_t d_2 = PARAM(l_1, "x", 1);
	int64_t d_3 = ROL(d_2, c_4);
	l_4 = RETURN(l_1, d_3);
}
