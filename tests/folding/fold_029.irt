--TEST--
029: FOLD: (x * c1) * c2 => x * (c1 * c2) truncates c1 * c2 to the type width
--ARGS--
--run
--CODE--
func main(int32_t): int32_t
{
	int32_t c_0 = 0;
	int32_t c_1 = 65536;
	uintptr_t f = func printf(uintptr_t, ...): int32_t;
	uintptr_t format = "%d\n";
	l_1 = START(l_4);
	int32_t d_2 = PARAM(l_1, "argc", 1);
	int32_t d_3 = MUL(d_2, c_1);
	int32_t d_4 = MUL(d_3, c_1);
	l_3 = CALL/2(l_1, f, format, d_4);
	l_4 = RETURN(l_3, c_0);
}
--EXPECT--
0
