--TEST--
034: FOLD: (x + c1) - c2 => x + (c1 - c2) truncates c1 - c2 to the type width
--ARGS--
-O2 --save
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int8_t c_4 = -100;
	int8_t c_5 = -56;
	int8_t c_6 = 100;
	uint8_t c_7 = 100;
	uint8_t c_8 = 156;
	uint8_t c_9 = 200;
	l_1 = START(l_13);
	int8_t d_2 = PARAM(l_1, "x", 1);
	uint8_t d_3 = PARAM(l_1, "u", 2);
	int8_t d_4 = ADD(d_2, c_6);
	int8_t d_5 = SUB(d_4, c_4);
	int8_t d_6 = SUB(d_5, d_2);
	bool d_7 = EQ(d_6, c_5);
	uint8_t d_8 = ADD(d_3, c_7);
	uint8_t d_9 = SUB(d_8, c_9);
	uint8_t d_10 = SUB(d_9, d_3);
	bool d_11 = EQ(d_10, c_8);
	bool d_12 = AND(d_7, d_11);
	l_13 = RETURN(l_1, d_12);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	l_1 = START(l_4);
	int8_t d_2 = PARAM(l_1, "x", 1);
	uint8_t d_3 = PARAM(l_1, "u", 2);
	l_4 = RETURN(l_1, c_3);
}
