--TEST--
Compare with a not normalized second operand (wrapped ADD result)
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @cmp_u8(uint8_t, uint8_t, uint8_t): int32_t;
func @cmp_u8(uint8_t, uint8_t, uint8_t): int32_t
{
	l_1 = START(l_E);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t y = PARAM(l_1, "y", 2);
	uint8_t z = PARAM(l_1, "z", 3);
	uint8_t s = ADD(x, y);
	uint8_t t = ADD(x, z);
	bool b = ULT(t, s);
	int32_t r = ZEXT(b);
	l_E = RETURN(l_1, r);
}
func @cmp_i8(int8_t, int8_t, int8_t): int32_t;
func @cmp_i8(int8_t, int8_t, int8_t): int32_t
{
	l_1 = START(l_E);
	int8_t x = PARAM(l_1, "x", 1);
	int8_t y = PARAM(l_1, "y", 2);
	int8_t z = PARAM(l_1, "z", 3);
	int8_t s = ADD(x, y);
	int8_t t = ADD(x, z);
	bool b = LT(t, s);
	int32_t r = ZEXT(b);
	l_E = RETURN(l_1, r);
}
func @cmp_u16(uint16_t, uint16_t, uint16_t): int32_t;
func @cmp_u16(uint16_t, uint16_t, uint16_t): int32_t
{
	l_1 = START(l_E);
	uint16_t x = PARAM(l_1, "x", 1);
	uint16_t y = PARAM(l_1, "y", 2);
	uint16_t z = PARAM(l_1, "z", 3);
	uint16_t s = ADD(x, y);
	uint16_t t = ADD(x, z);
	bool b = ULT(t, s);
	int32_t r = ZEXT(b);
	l_E = RETURN(l_1, r);
}
func @cmp_i16(int16_t, int16_t, int16_t): int32_t;
func @cmp_i16(int16_t, int16_t, int16_t): int32_t
{
	l_1 = START(l_E);
	int16_t x = PARAM(l_1, "x", 1);
	int16_t y = PARAM(l_1, "y", 2);
	int16_t z = PARAM(l_1, "z", 3);
	int16_t s = ADD(x, y);
	int16_t t = ADD(x, z);
	bool b = LT(t, s);
	int32_t r = ZEXT(b);
	l_E = RETURN(l_1, r);
}
func @main(): int32_t
{
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d\n";
	int32_t zero = 0;
	uint8_t x0 = 250;
	uint8_t y0 = 10;
	uint8_t z0 = 3;
	uintptr_t f0 = func @cmp_u8(uint8_t, uint8_t, uint8_t): int32_t;
	int8_t x1 = 100;
	int8_t y1 = 100;
	int8_t z1 = 1;
	uintptr_t f1 = func @cmp_i8(int8_t, int8_t, int8_t): int32_t;
	uint16_t x2 = 65530;
	uint16_t y2 = 10;
	uint16_t z2 = 3;
	uintptr_t f2 = func @cmp_u16(uint16_t, uint16_t, uint16_t): int32_t;
	int16_t x3 = 32000;
	int16_t y3 = 1000;
	int16_t z3 = 1;
	uintptr_t f3 = func @cmp_i16(int16_t, int16_t, int16_t): int32_t;
	l_0 = START(l_end);
	int32_t r0, c0 = CALL/3(l_0, f0, x0, y0, z0);
	p0 = CALL/2(c0, fp, fmt, r0);
	int32_t r1, c1 = CALL/3(p0, f1, x1, y1, z1);
	p1 = CALL/2(c1, fp, fmt, r1);
	int32_t r2, c2 = CALL/3(p1, f2, x2, y2, z2);
	p2 = CALL/2(c2, fp, fmt, r2);
	int32_t r3, c3 = CALL/3(p2, f3, x3, y3, z3);
	p3 = CALL/2(c3, fp, fmt, r3);
	l_end = RETURN(p3, zero);
}
--EXPECT--
0
0
0
0
