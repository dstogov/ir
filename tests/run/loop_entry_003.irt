--TEST--
Loop invariant initialization after an indirect entry predecessor
--ARGS--
--run
--CODE--
{
	int32_t c_1 = 0;
	int32_t c_2 = 128;
	uintptr_t c_3 = "%d\n";
	uintptr_t c_4 = func printf(uintptr_t, ...): int32_t;
	l_1 = START(l_17);
	l_2 = END(l_1);
	l_3 = ENTRY(l_2, 1);
	int32_t d_4, l_4 = CALL/2(l_3, c_4, c_3, c_1);
	bool d_5 = GE(d_4, c_1);
	l_5 = IF(l_4, d_5);
	l_6 = IF_TRUE(l_5);
	l_7 = END(l_6);
	l_8 = LOOP_BEGIN/3(l_2, l_7, l_13);
	int32_t d_9 = COPY(c_2, 1);
	int32_t d_10, l_10 = CALL/2(l_8, c_4, c_3, d_9);
	bool d_11 = LT(d_10, c_1);
	l_11 = IF(l_10, d_11);
	l_12 = IF_TRUE(l_11);
	l_13 = LOOP_END(l_12);
	l_14 = IF_FALSE(l_11);
	l_15 = RETURN(l_14, c_1);
	l_16 = IF_FALSE(l_5);
	l_17 = RETURN(l_16, c_1, l_15);
}
--EXPECT--
128
