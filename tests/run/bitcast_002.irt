--TEST--
BITCAST 002: regression double constant to integer bits
--ARGS--
-O0 --run
--CODE--
extern func @printf(uintptr_t, ...): void;
static const @format[6] = "%llx\n\000";
func @main(): int32_t
{
	double c_1 = 1.0;
	uintptr_t c_2 = func @printf(uintptr_t, ...): void;
	uintptr_t c_3 = sym(@format);
	int32_t c_4 = 0;
	l_1 = START(l_4);
	uint64_t d_2 = BITCAST(c_1);
	l_3 = CALL/2(l_1, c_2, c_3, d_2);
	l_4 = RETURN(l_3, c_4);
}
--EXPECT--
3ff0000000000000
