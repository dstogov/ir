--TEST--
MIN/MAX of 8-bit and 16-bit values with not normalized upper bits
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @test8(int8_t, int8_t): void;
func @test8(int8_t, int8_t): void
{
	int8_t c_1 = 1;
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d %d\n";
	l_1 = START(l_3);
	int8_t x = PARAM(l_1, "x", 1);
	int8_t y = PARAM(l_1, "y", 2);
	int8_t s = ADD(x, c_1);
	int8_t mn = MIN(s, y);
	int8_t mx = MAX(s, y);
	int32_t a = SEXT(mn);
	int32_t b = SEXT(mx);
	l_2 = CALL/3(l_1, fp, fmt, a, b);
	l_3 = RETURN(l_2);
}
func @test16(int16_t, int16_t): void;
func @test16(int16_t, int16_t): void
{
	int16_t c_1 = 1;
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d %d\n";
	l_1 = START(l_3);
	int16_t x = PARAM(l_1, "x", 1);
	int16_t y = PARAM(l_1, "y", 2);
	int16_t s = ADD(x, c_1);
	int16_t mn = MIN(s, y);
	int16_t mx = MAX(s, y);
	int32_t a = SEXT(mn);
	int32_t b = SEXT(mx);
	l_2 = CALL/3(l_1, fp, fmt, a, b);
	l_3 = RETURN(l_2);
}
func @testu8(uint8_t, uint8_t): void;
func @testu8(uint8_t, uint8_t): void
{
	uint8_t c_1 = 1;
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d %d\n";
	l_1 = START(l_3);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t y = PARAM(l_1, "y", 2);
	uint8_t s = ADD(x, c_1);
	uint8_t mn = MIN(s, y);
	uint8_t mx = MAX(s, y);
	int32_t a = ZEXT(mn);
	int32_t b = ZEXT(mx);
	l_2 = CALL/3(l_1, fp, fmt, a, b);
	l_3 = RETURN(l_2);
}
func @testu16(uint16_t, uint16_t): void;
func @testu16(uint16_t, uint16_t): void
{
	uint16_t c_1 = 1;
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d %d\n";
	l_1 = START(l_3);
	uint16_t x = PARAM(l_1, "x", 1);
	uint16_t y = PARAM(l_1, "y", 2);
	uint16_t s = ADD(x, c_1);
	uint16_t mn = MIN(s, y);
	uint16_t mx = MAX(s, y);
	int32_t a = ZEXT(mn);
	int32_t b = ZEXT(mx);
	l_2 = CALL/3(l_1, fp, fmt, a, b);
	l_3 = RETURN(l_2);
}
func @main(): int32_t
{
	uintptr_t f8 = func @test8(int8_t, int8_t): void;
	uintptr_t f16 = func @test16(int16_t, int16_t): void;
	uintptr_t fu8 = func @testu8(uint8_t, uint8_t): void;
	uintptr_t fu16 = func @testu16(uint16_t, uint16_t): void;
	int8_t a8 = 127;
	int8_t b8 = 0;
	int16_t a16 = 32767;
	int16_t b16 = 0;
	uint8_t au8 = 255;
	uint8_t bu8 = 5;
	uint16_t au16 = 65535;
	uint16_t bu16 = 5;
	int32_t z = 0;
	l_1 = START(l_6);
	l_2 = CALL/2(l_1, f8, a8, b8);
	l_3 = CALL/2(l_2, f16, a16, b16);
	l_4 = CALL/2(l_3, fu8, au8, bu8);
	l_5 = CALL/2(l_4, fu16, au16, bu16);
	l_6 = RETURN(l_5, z);
}
--EXPECT--
-128 0
-32768 0
0 5
0 5
