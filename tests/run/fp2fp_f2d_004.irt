--TEST--
FP2FP(double) of float MUL keeps float rounding
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @mul(double, double): double;
func @mul(double, double): double
{
	l_1 = START(l_E);
	double x = PARAM(l_1, "x", 1);
	double y = PARAM(l_1, "y", 2);
	float fx = FP2FP(x);
	float fy = FP2FP(y);
	float a = MUL(fx, fy);
	double r = FP2FP(a);
	l_E = RETURN(l_1, r);
}
func @main(): int32_t
{
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%.17g\n";
	uintptr_t f = func @mul(double, double): double;
	int32_t z = 0;
	double a = 1.00000011920928955;
	double b = 1.00000011920928955;
	l_0 = START(l_end);
	double r, c = CALL/2(l_0, f, a, b);
	p = CALL/2(c, fp, fmt, r);
	l_end = RETURN(p, z);
}
--EXPECT--
1.0000002384185791
