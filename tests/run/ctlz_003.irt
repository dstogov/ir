--TEST--
CTLZ 003: CTLZ(ZEXT(x)) - (dst_bits - src_bits)
--ARGS--
--run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func ctlz16(uint16_t): uint32_t
{
	uint32_t c_1 = 16;
	l_1 = START(l_6);
	uint16_t d_2 = PARAM(l_1, "arg_1", 1);
	uint32_t d_3 = ZEXT(d_2);
	uint32_t d_4 = CTLZ(d_3);
	uint32_t d_5 = SUB(d_4, c_1);
	l_6 = RETURN(l_1, d_5);
}
func ctlz8(uint8_t): uint32_t
{
	uint32_t c_1 = 24;
	l_1 = START(l_6);
	uint8_t d_2 = PARAM(l_1, "arg_1", 1);
	uint32_t d_3 = ZEXT(d_2);
	uint32_t d_4 = CTLZ(d_3);
	uint32_t d_5 = SUB(d_4, c_1);
	l_6 = RETURN(l_1, d_5);
}
func ctlz32(uint32_t): int32_t
{
	int32_t c_1 = 32;
	l_1 = START(l_6);
	uint32_t d_2 = PARAM(l_1, "arg_1", 1);
	uint64_t d_3 = ZEXT(d_2);
	int32_t d_4 = CTLZ(d_3);
	int32_t d_5 = SUB(d_4, c_1);
	l_6 = RETURN(l_1, d_5);
}
func main(void): int32_t
{
	uintptr_t c_1 = func ctlz16(uint16_t): uint32_t;
	uint16_t c_2 = 1;
	uint16_t c_3 = 1536;
	uint16_t c_4 = 32768;
	uintptr_t c_5 = "u16: %u %u %u\n";
	uintptr_t c_6 = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_7 = func ctlz8(uint8_t): uint32_t;
	uint8_t c_8 = 1;
	uint8_t c_9 = 96;
	uint8_t c_10 = 128;
	uintptr_t c_11 = "u8 : %u %u %u\n";
	int32_t c_12 = 0;
	uintptr_t c_13 = func ctlz32(uint32_t): int32_t;
	uint32_t c_14 = 1;
	uint32_t c_15 = 393216;
	uint32_t c_16 = 2147483648;
	uintptr_t c_17 = "u32: %d %d %d\n";
	l_1 = START(l_14);
	uint32_t d_2, l_2 = CALL/1(l_1, c_1, c_2);
	uint32_t d_3, l_3 = CALL/1(l_2, c_1, c_3);
	uint32_t d_4, l_4 = CALL/1(l_3, c_1, c_4);
	int32_t d_5, l_5 = CALL/4(l_4, c_6, c_5, d_2, d_3, d_4);
	uint32_t d_6, l_6 = CALL/1(l_5, c_7, c_8);
	uint32_t d_7, l_7 = CALL/1(l_6, c_7, c_9);
	uint32_t d_8, l_8 = CALL/1(l_7, c_7, c_10);
	int32_t d_9, l_9 = CALL/4(l_8, c_6, c_11, d_6, d_7, d_8);
	int32_t d_10, l_10 = CALL/1(l_9, c_13, c_14);
	int32_t d_11, l_11 = CALL/1(l_10, c_13, c_15);
	int32_t d_12, l_12 = CALL/1(l_11, c_13, c_16);
	int32_t d_13, l_13 = CALL/4(l_12, c_6, c_17, d_10, d_11, d_12);
	l_14 = RETURN(l_13, c_12);
}
