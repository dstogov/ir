--TEST--
Bit counting of 8/16-bit operands
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @cttz_u16(uint16_t): int32_t
{
	l_1 = START(l_2);
	uint16_t x = PARAM(l_1, "x", 1);
	int32_t r = CTTZ(x);
	l_2 = RETURN(l_1, r);
}
func @ctlz_u16(uint16_t): int32_t
{
	l_1 = START(l_2);
	uint16_t x = PARAM(l_1, "x", 1);
	int32_t r = CTLZ(x);
	l_2 = RETURN(l_1, r);
}
func @ctpop_u16(uint16_t): int32_t
{
	l_1 = START(l_2);
	uint16_t x = PARAM(l_1, "x", 1);
	int32_t r = CTPOP(x);
	l_2 = RETURN(l_1, r);
}
func @cttz_u8_trunc(uint32_t): int32_t
{
	l_1 = START(l_2);
	uint32_t a = PARAM(l_1, "a", 1);
	uint8_t x = TRUNC(a);
	int32_t r = CTTZ(x);
	l_2 = RETURN(l_1, r);
}
func @ctlz_u8_trunc(uint32_t): int32_t
{
	l_1 = START(l_2);
	uint32_t a = PARAM(l_1, "a", 1);
	uint8_t x = TRUNC(a);
	int32_t r = CTLZ(x);
	l_2 = RETURN(l_1, r);
}
func @ctpop_u8_trunc(uint32_t): int32_t
{
	l_1 = START(l_2);
	uint32_t a = PARAM(l_1, "a", 1);
	uint8_t x = TRUNC(a);
	int32_t r = CTPOP(x);
	l_2 = RETURN(l_1, r);
}
func @cttz_u16_trunc(uint32_t): int32_t
{
	l_1 = START(l_2);
	uint32_t a = PARAM(l_1, "a", 1);
	uint16_t x = TRUNC(a);
	int32_t r = CTTZ(x);
	l_2 = RETURN(l_1, r);
}
func @ctlz_u16_trunc(uint32_t): int32_t
{
	l_1 = START(l_2);
	uint32_t a = PARAM(l_1, "a", 1);
	uint16_t x = TRUNC(a);
	int32_t r = CTLZ(x);
	l_2 = RETURN(l_1, r);
}
func @ctpop_u16_trunc(uint32_t): int32_t
{
	l_1 = START(l_2);
	uint32_t a = PARAM(l_1, "a", 1);
	uint16_t x = TRUNC(a);
	int32_t r = CTPOP(x);
	l_2 = RETURN(l_1, r);
}
func @cttz_u8_mem(uintptr_t): int32_t
{
	l_1 = START(l_2);
	uintptr_t p = PARAM(l_1, "p", 1);
	uint8_t x, l_3 = LOAD(l_1, p);
	int32_t r = CTTZ(x);
	l_2 = RETURN(l_3, r);
}
func @ctlz_u8_mem(uintptr_t): int32_t
{
	l_1 = START(l_2);
	uintptr_t p = PARAM(l_1, "p", 1);
	uint8_t x, l_3 = LOAD(l_1, p);
	int32_t r = CTLZ(x);
