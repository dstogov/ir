}
func @cttz_u16_mem(uintptr_t): int32_t
{
	l_1 = START(l_2);
	uintptr_t p = PARAM(l_1, "p", 1);
	uint16_t x, l_3 = LOAD(l_1, p);
	int32_t r = CTTZ(x);
