--TEST--
Loop invariant initialization after an entry predecessor
--ARGS--
--run
--CODE--
{
	int32_t c_1 = 0;
	int32_t c_2 = 128;
	uintptr_t c_3 = "%d\n";
	uintptr_t c_4 = func printf(uintptr_t, ...): int32_t;
	l_1 = START(l_12);
	l_2 = END(l_1);
	l_3 = ENTRY(l_2, 1);
	l_4 = END(l_3);
	l_5 = LOOP_BEGIN/3(l_2, l_4, l_10);
	int32_t d_6 = COPY(c_2, 1);
	int32_t d_7, l_7 = CALL/2(l_5, c_4, c_3, d_6);
	bool d_8 = LT(d_7, c_1);
	l_8 = IF(l_7, d_8);
	l_9 = IF_TRUE(l_8);
	l_10 = LOOP_END(l_9);
	l_11 = IF_FALSE(l_8);
	l_12 = RETURN(l_11, c_1);
}
--EXPECT--
128
