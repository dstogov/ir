--TEST--
All integer comparison conditions on narrow integers with not normalized upper bits (non-zero constant)
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @cmp_all_u8(uint8_t, uint8_t): int32_t;
func @cmp_all_u8(uint8_t, uint8_t): int32_t
{
	uint8_t c = 5;
	int32_t w0 = 1;
	int32_t w1 = 2;
	int32_t w2 = 4;
	int32_t w3 = 8;
	int32_t w4 = 16;
	int32_t w5 = 32;
	l_1 = START(l_E);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t y = PARAM(l_1, "y", 2);
	uint8_t s = ADD(x, y);
	bool b0 = EQ(s, c);
	int32_t v0 = ZEXT(b0);
	int32_t m0 = MUL(v0, w0);
	bool b1 = NE(s, c);
	int32_t v1 = ZEXT(b1);
	int32_t m1 = MUL(v1, w1);
	bool b2 = ULT(s, c);
	int32_t v2 = ZEXT(b2);
	int32_t m2 = MUL(v2, w2);
	bool b3 = UGE(s, c);
	int32_t v3 = ZEXT(b3);
	int32_t m3 = MUL(v3, w3);
	bool b4 = ULE(s, c);
	int32_t v4 = ZEXT(b4);
	int32_t m4 = MUL(v4, w4);
	bool b5 = UGT(s, c);
	int32_t v5 = ZEXT(b5);
	int32_t m5 = MUL(v5, w5);
	int32_t a1 = ADD(m0, m1);
	int32_t a2 = ADD(a1, m2);
	int32_t a3 = ADD(a2, m3);
	int32_t a4 = ADD(a3, m4);
	int32_t a5 = ADD(a4, m5);
	l_E = RETURN(l_1, a5);
}
