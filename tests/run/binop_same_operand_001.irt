--TEST--
64-bit ADD/SUB/OR/AND/XOR with the same operand twice
--CODE--
func add(uint64_t): uint64_t
{
	l_1 = START(l_4);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	uint64_t d_3 = ADD(d_2, d_2);
	l_4 = RETURN(l_1, d_3);
}
func sub(uint64_t): uint64_t
{
	l_1 = START(l_4);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	uint64_t d_3 = SUB(d_2, d_2);
	l_4 = RETURN(l_1, d_3);
}
func or(uint64_t): uint64_t
{
	l_1 = START(l_4);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	uint64_t d_3 = OR(d_2, d_2);
	l_4 = RETURN(l_1, d_3);
}
func and(uint64_t): uint64_t
{
	l_1 = START(l_4);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	uint64_t d_3 = AND(d_2, d_2);
	l_4 = RETURN(l_1, d_3);
}
func xor(uint64_t): uint64_t
{
	l_1 = START(l_4);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	uint64_t d_3 = XOR(d_2, d_2);
	l_4 = RETURN(l_1, d_3);
}
func main(): int32_t
{
	int32_t c_1 = 0;
	uintptr_t c_2 = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_3 = func add(uint64_t): uint64_t;
	uintptr_t c_4 = func sub(uint64_t): uint64_t;
	uintptr_t c_5 = func or(uint64_t): uint64_t;
	uintptr_t c_6 = func and(uint64_t): uint64_t;
	uintptr_t c_7 = func xor(uint64_t): uint64_t;
	uintptr_t c_8 = "%llx %llx %llx %llx %llx\n";
	uint64_t c_9 = 1311768467463790320;
	l_1 = START(l_8);
	uint64_t d_2, l_2 = CALL/1(l_1, c_3, c_9);
	uint64_t d_3, l_3 = CALL/1(l_2, c_4, c_9);
	uint64_t d_4, l_4 = CALL/1(l_3, c_5, c_9);
	uint64_t d_5, l_5 = CALL/1(l_4, c_6, c_9);
	uint64_t d_6, l_6 = CALL/1(l_5, c_7, c_9);
	int32_t d_7, l_7 = CALL/6(l_6, c_2, c_8, d_2, d_3, d_4, d_5, d_6);
	l_8 = RETURN(l_7, c_1);
}
--EXPECT--
2468acf13579bde0 0 123456789abcdef0 123456789abcdef0 0
