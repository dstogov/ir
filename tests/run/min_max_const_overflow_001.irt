--TEST--
MIN/MAX with adjusted constant at the type boundary
--ARGS--
--run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @ule(uint64_t): uint64_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uint64_t c_4 = 0xffffffffffffffff;
	uint64_t c_5 = 0;
	l_1 = START(l_9);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	bool d_3 = ULE(d_2, c_4);
	l_2 = IF(l_1, d_3);
	l_3 = IF_TRUE(l_2);
	l_4 = END(l_3);
	l_5 = IF_FALSE(l_2);
	l_6 = END(l_5);
	l_7 = MERGE(l_4, l_6);
	uint64_t d_4 = PHI(l_7, c_5, d_2);
	l_9 = RETURN(l_7, d_4);
}
