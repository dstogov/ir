func @main(): int32_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	uintptr_t c_4 = func @ule(uint64_t): uint64_t;
	uintptr_t c_5 = func @uge(uint64_t): uint64_t;
	uintptr_t c_6 = func @le(int64_t): int64_t;
	uintptr_t c_7 = func @ge(int64_t): int64_t;
	uintptr_t c_8 = func @printf(uintptr_t, ...): int32_t;
	uintptr_t c_9 = "%llu %llu %lld %lld\n";
	uint64_t c_10 = 7;
	int64_t c_11 = 7;
	int32_t c_12 = 0;
	l_1 = START(l_7);
	uint64_t d_2, l_2 = CALL/1(l_1, c_4, c_10);
	uint64_t d_3, l_3 = CALL/1(l_2, c_5, c_10);
	int64_t d_4, l_4 = CALL/1(l_3, c_6, c_11);
	int64_t d_5, l_5 = CALL/1(l_4, c_7, c_11);
	int32_t d_6, l_6 = CALL/5(l_5, c_8, c_9, d_2, d_3, d_4, d_5);
	l_7 = RETURN(l_6, c_12);
}
