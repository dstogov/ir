	l_5 = IF_FALSE(l_2);
	l_6 = END(l_5);
	l_7 = MERGE(l_4, l_6);
	uint64_t d_4 = PHI(l_7, c_5, d_2);
	l_9 = RETURN(l_7, d_4);
}
