--TEST--
SWITCH on narrow integers with not normalized upper bits
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @switch_u8_0(uint8_t, uint8_t): int32_t;
func @switch_u8_0(uint8_t, uint8_t): int32_t
{
	uint8_t k0 = 0;
	int32_t r0 = 10;
	uint8_t k1 = 1;
	int32_t r1 = 11;
	uint8_t k2 = 2;
	int32_t r2 = 12;
	int32_t rd = 99;
	l_1 = START(l_E);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t y = PARAM(l_1, "y", 2);
	uint8_t s = ADD(x, y);
	l_4 = SWITCH(l_1, s);
	l_c0 = CASE_VAL(l_4, k0);
	int32_t x0 = COPY(r0);
	l_e0 = END(l_c0);
	l_c1 = CASE_VAL(l_4, k1);
	int32_t x1 = COPY(r1);
	l_e1 = END(l_c1);
	l_c2 = CASE_VAL(l_4, k2);
	int32_t x2 = COPY(r2);
	l_e2 = END(l_c2);
	l_cd = CASE_DEFAULT(l_4);
	int32_t xd = COPY(rd);
	l_ed = END(l_cd);
	l_m = MERGE/4(l_e0, l_e1, l_e2, l_ed);
	int32_t r = PHI/4(l_m, x0, x1, x2, xd);
	l_E = RETURN(l_m, r);
}
