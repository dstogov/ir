--TEST--
EQ fold of float constants: -0.0 == 0.0
--ARGS--
--run
--CODE--
extern func @printf(uintptr_t, ...): void;
static const @format[4] = "%d\n\000";
func @main(): int32_t
{
	float c_1 = -0.0;
	float c_2 = 0.0;
	uintptr_t c_3 = func @printf(uintptr_t, ...): void;
	uintptr_t c_4 = sym(@format);
	int32_t c_5 = 0;
	l_1 = START(l_6);
	bool d_2 = EQ(c_1, c_2);
	int32_t d_3 = ZEXT(d_2);
	l_4 = CALL/2(l_1, c_3, c_4, d_3);
	l_6 = RETURN(l_4, c_5);
}
--EXPECT--
1
