--TEST--
Simple register allocator: value stored to VAR on a not-taken branch
--ARGS--
-O0 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
static const @format[4] = "%d\n\000";
func @main(): int32_t
{
	uintptr_t c_p = func @printf(uintptr_t, ...): int32_t;
	uintptr_t c_f = sym(@format);
	int32_t c_0 = 0;
	int32_t c_1 = 1;
	int32_t c_5 = 5;
	l_1 = START(l_ret);
	int32_t x = VAR(l_1, "x");
	l_2 = VSTORE(l_1, x, c_5);
	int32_t a, l_3 = VLOAD(l_2, x);
	int32_t v = ADD(a, c_1);
	bool cond = EQ(a, c_0);
	l_4 = IF(l_3, cond);
	l_5 = IF_TRUE(l_4);
	l_6 = VSTORE(l_5, x, v);
	l_7 = END(l_6);
	l_8 = IF_FALSE(l_4);
	l_9 = END(l_8);
	l_10 = MERGE(l_7, l_9);
	int32_t xv, l_11 = VLOAD(l_10, x);
	int32_t r, l_12 = CALL/2(l_11, c_p, c_f, xv);
	l_ret = RETURN(l_12, c_0);
}
--EXPECT--
5
