--TEST--
Dead 64-bit values whose only uses are dead on 32-bit x86
--TARGET--
x86
--CODE--
func test1(uint64_t, uint64_t): int32_t
{
	int32_t c_1 = 23;
	l_1 = START(l_3);
	uint64_t d_2 = PARAM(l_1, "a", 1);
	uint64_t d_3 = PARAM(l_1, "b", 2);
	uint64_t d_4 = ADD(d_2, d_3);
	uintptr_t d_5 = TRUNC(d_4);
	int32_t d_6, l_2 = LOAD(l_1, d_5);
	l_3 = RETURN(l_2, c_1);
}
func test2(uint64_t, uint64_t, bool): int32_t
{
	int32_t c_1 = 42;
	l_1 = START(l_12);
	uint64_t d_2 = PARAM(l_1, "a", 1);
	uint64_t d_3 = PARAM(l_1, "b", 2);
	bool d_4 = PARAM(l_1, "flag", 3);
	l_5 = IF(l_1, d_4);
	l_6 = IF_TRUE(l_5);
	l_7 = END(l_6);
	l_8 = IF_FALSE(l_5);
	l_9 = END(l_8);
	l_10 = MERGE(l_7, l_9);
	uint64_t d_11 = PHI(l_10, d_2, d_3);
	uintptr_t d_12 = TRUNC(d_11);
	int32_t d_13, l_11 = LOAD(l_10, d_12);
	l_12 = RETURN(l_11, c_1);
}
func test3(uint64_t, uint64_t): uint64_t
{
	l_1 = START(l_2);
	uint64_t d_2 = PARAM(l_1, "a", 1);
	uint64_t d_3 = PARAM(l_1, "b", 2);
	uint64_t d_4 = ADD(d_2, d_3);
	l_2 = RETURN(l_1, d_4);
}
func main(): int32_t
{
	int32_t c_1 = 0;
	uint64_t c_2 = 0;
	uint64_t c_3 = 0x100000002;
	uint64_t c_4 = 0x300000004;
	bool c_5 = 1;
	bool c_6 = 0;
	uintptr_t c_7 = func test1(uint64_t, uint64_t): int32_t;
	uintptr_t c_8 = func test2(uint64_t, uint64_t, bool): int32_t;
	uintptr_t c_9 = func test3(uint64_t, uint64_t): uint64_t;
	uintptr_t c_10 = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_11 = "%d %d %d %llx\n";
	l_1 = START(l_7);
	int32_t d_2, l_2 = CALL/2(l_1, c_7, c_2, c_2);
	int32_t d_3, l_3 = CALL/3(l_2, c_8, c_2, c_2, c_5);
	int32_t d_4, l_4 = CALL/3(l_3, c_8, c_2, c_2, c_6);
	uint64_t d_5, l_5 = CALL/2(l_4, c_9, c_3, c_4);
	int32_t d_6, l_6 = CALL/5(l_5, c_10, c_11, d_2, d_3, d_4, d_5);
	l_7 = RETURN(l_6, c_1);
}
--EXPECT--
23 42 42 400000006
