--TEST--
SAME_CMP 001: repeated comparison after a flags-clobbering instruction
--ARGS--
--run
--CODE--
extern func @printf(uintptr_t, ...): void;
func @test(int32_t, int32_t): int32_t;
static const @fmt[4] = "%d\n\000";
func @main(): int32_t
{
	int32_t c_0 = 0;
	int32_t c_1 = 1;
	int32_t c_2 = 2;
	int32_t c_3 = -1;
	uintptr_t f = func @test(int32_t, int32_t): int32_t;
	uintptr_t p = func @printf(uintptr_t, ...): void;
	uintptr_t s = sym(@fmt);
	l_1 = START(l_4);
	int32_t d, l_2 = CALL/2(l_1, f, c_3, c_2);
	l_3 = CALL/2(l_2, p, s, d);
	l_4 = RETURN(l_3, c_0);
}
func @test(int32_t, int32_t): int32_t
{
	int32_t c_0 = 0;
	int32_t c_1 = 1;
	int32_t c_2 = 2;
	l_1 = START(l_14);
	int32_t a = PARAM(l_1, "a", 1);
	int32_t b = PARAM(l_1, "b", 2);
	bool d_1 = EQ(a, b);
	l_2 = IF(l_1, d_1);
	l_3 = IF_TRUE(l_2);
	l_4 = END(l_3);
	l_5 = IF_FALSE(l_2);
	int32_t x = XOR(a, b);
	bool d_2 = LT(a, b);
	l_6 = IF(l_5, d_2);
	l_7 = IF_TRUE(l_6);
	int32_t y = ADD(x, c_1);
	l_8 = END(l_7);
	l_9 = IF_FALSE(l_6);
	int32_t z = ADD(x, c_2);
	l_10 = END(l_9);
	l_11 = MERGE/3(l_4, l_8, l_10);
	int32_t r = PHI/3(l_11, c_0, y, z);
	l_14 = RETURN(l_11, r);
}
--EXPECT--
-2
