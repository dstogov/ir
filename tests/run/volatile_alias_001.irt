--TEST--
Volatile accesses stop load forwarding and dead store elimination
--CODE--
func load_fwd(uintptr_t): int32_t
{
	int32_t c_1 = 11;
	int32_t c_2 = 22;
	l_1 = START(l_5);
	uintptr_t p = PARAM(l_1, "p", 1);
	l_2 = STORE(l_1, p, c_1);
	l_3 = STORE_v(l_2, p, c_2);
	int32_t x, l_4 = LOAD(l_3, p);
	l_5 = RETURN(l_4, x);
}
func store_dse(uintptr_t): int32_t
{
	int32_t c_1 = 11;
	int32_t c_2 = 22;
	l_1 = START(l_5);
	uintptr_t p = PARAM(l_1, "p", 1);
	l_2 = STORE(l_1, p, c_2);
	int32_t x, l_3 = LOAD_v(l_2, p);
	l_4 = STORE(l_3, p, c_1);
	l_5 = RETURN(l_4, x);
}
func vload_fwd(): int32_t
{
	int32_t c_1 = 11;
	int32_t c_2 = 22;
	l_1 = START(l_5);
	int32_t v = VAR(l_1, "v");
	l_2 = VSTORE(l_1, v, c_1);
	l_3 = VSTORE_v(l_2, v, c_2);
	int32_t x, l_4 = VLOAD(l_3, v);
	l_5 = RETURN(l_4, x);
}
func vstore_dse(): int32_t
{
	int32_t c_1 = 11;
	int32_t c_2 = 22;
	int32_t c_7 = 7;
	l_1 = START(l_6);
	int32_t v = VAR(l_1, "v");
	l_2 = VSTORE_v(l_1, v, c_7);
	l_3 = VSTORE(l_2, v, c_2);
	int32_t x, l_4 = VLOAD_v(l_3, v);
	l_5 = VSTORE(l_4, v, c_1);
	l_6 = RETURN(l_5, x);
}
func main(): int32_t
{
	uintptr_t c_8 = 8;
	int32_t c_7 = 7;
	int32_t c_0 = 0;
	uintptr_t f_1 = func load_fwd(uintptr_t): int32_t;
	uintptr_t f_2 = func store_dse(uintptr_t): int32_t;
	uintptr_t f_3 = func vload_fwd(): int32_t;
	uintptr_t f_4 = func vstore_dse(): int32_t;
	uintptr_t printf = func printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d %d %d %d %d %d\n";
	l_1 = START(l_13);
	uintptr_t a, l_2 = ALLOCA(l_1, c_8);
	l_3 = STORE(l_2, a, c_7);
	int32_t r_1, l_4 = CALL/1(l_3, f_1, a);
	int32_t m_1, l_5 = LOAD(l_4, a);
	l_6 = STORE(l_5, a, c_7);
	int32_t r_2, l_7 = CALL/1(l_6, f_2, a);
	int32_t m_2, l_8 = LOAD(l_7, a);
	int32_t r_3, l_9 = CALL(l_8, f_3);
	int32_t r_4, l_10 = CALL(l_9, f_4);
	int32_t d, l_11 = CALL/7(l_10, printf, fmt, r_1, m_1, r_2, m_2, r_3, r_4);
	l_13 = RETURN(l_11, c_0);
}
--EXPECT--
22 22 22 11 22 22
