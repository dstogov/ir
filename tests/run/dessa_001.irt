--TEST--
DESSA 001: DESSA and spill load
--TARGET--
*64-*
--ARGS--
--run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
static const @str.1[4] = "%d\n\000";
func @spill(): void __preserve_none
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
#BB1: end=l_2
	l_1 = START(l_2);
	l_2 = RETURN(l_1, null);
}
func @main(int32_t, uintptr_t): int32_t
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	int32_t c_4 = 1;
	char c_5 = '\0';
	int32_t c_6 = 20;
	int32_t c_7 = 30;
	int32_t c_8 = 40;
	int32_t c_9 = 10;
	uintptr_t c_10 = func @spill(): void __preserve_none;
	uintptr_t c_11 = func @printf(uintptr_t, ...): int32_t;
	uintptr_t c_12 = sym(@str.1);
	int32_t c_13 = 0;
#BB1: end=l_5, succ(2)=[BB2, BB3]
	l_1 = START(l_25);
	int32_t d_2 = PARAM(l_1, "argc", 1);
	uintptr_t d_3 = PARAM(l_1, "argv", 2);
	bool d_4 = GT(d_2, c_4);
	l_5 = IF(l_1, d_4);
#BB2: end=l_12, idom=BB1(1), pred(1)=[BB1], succ(1)=[BB4]
	l_6 = IF_TRUE(l_5);
	uintptr_t d_7, l_7 = ALLOCA(l_6, d_2);
	l_8 = STORE(l_7, d_7, c_5);
	int32_t d_9 = MUL(d_2, c_6);
	int32_t d_10 = MUL(d_2, c_7);
	int32_t d_11 = MUL(d_2, c_8);
	l_12 = END(l_8);
#BB3: end=l_16, idom=BB1(1), pred(1)=[BB1], succ(1)=[BB4]
	l_13 = IF_FALSE(l_5);
	int32_t d_14 = MUL(d_2, c_9);
	l_15 = CALL(l_13, c_10);
	l_16 = END(l_15);
#BB4: end=l_25, idom=BB1(1), pred(2)=[BB2, BB3]
	l_17 = MERGE(l_12, l_16);
	int32_t d_18 = PHI(l_17, d_9, d_14);
	int32_t d_19 = PHI(l_17, d_10, d_14);
	int32_t d_20 = PHI(l_17, d_11, d_14);
	int32_t d_21 = ADD(d_19, d_18);
	int32_t d_22 = ADD(d_21, d_20);
	int32_t d_23, l_23 = CALL/2(l_17, c_11, c_12, d_22);
	l_25 = RETURN(l_23, c_13);
}
