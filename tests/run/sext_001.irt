--TEST--
SEXT 001: regression signed 32-bit constant extension
--ARGS--
--run
--CODE--
extern func @printf(uintptr_t, ...): void;
static const @format[6] = "%lld\n\000";
func @main(): int32_t
{
	int32_t c_1 = -1;
	uintptr_t c_2 = func @printf(uintptr_t, ...): void;
	uintptr_t c_3 = sym(@format);
	int32_t c_4 = 0;
	l_1 = START(l_4);
	int64_t d_2 = SEXT(c_1);
	l_3 = CALL/2(l_1, c_2, c_3, d_2);
	l_4 = RETURN(l_3, c_4);
}
--EXPECT--
-1
