--TEST--
SAR 011: int8_t constant shift count 8
--ARGS--
-O1 --run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func test(int8_t): int32_t
{
	int32_t c_0 = 0;
	int32_t c_1 = 8;
	uintptr_t c_2 = "%x\n";
	uintptr_t c_3 = func printf(uintptr_t, ...): int32_t;
	l_1 = START(l_4);
	int8_t d_2 = PARAM(l_1, "x", 1);
	int8_t d_3 = SAR(d_2, c_1);
	int32_t d_4 = ZEXT(d_3);
	int32_t d_5, l_5 = CALL/2(l_1, c_3, c_2, d_4);
	l_4 = RETURN(l_5, c_0);
}
func main(): int32_t
{
	uintptr_t c_1 = func test(int8_t): int32_t;
	int8_t c_2 = -128;
	l_1 = START(l_3);
	int32_t d_2, l_2 = CALL/1(l_1, c_1, c_2);
	l_3 = RETURN(l_2, d_2);
}
--EXPECT--
ff
