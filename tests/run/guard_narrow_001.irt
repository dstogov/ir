func @main(): int32_t
{
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d\n";
	int32_t z = 0;
	uint8_t a0 = 255;
	uint8_t b0 = 1;
