--TEST--
GUARD/GUARD_NOT on narrow integers with not normalized upper bits
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @h(): int32_t
{
	int32_t c = 5;
	l_1 = START(l_2);
	l_2 = RETURN(l_1, c);
}
func @guard_u8(uint8_t, uint8_t): int32_t;
func @guard_u8(uint8_t, uint8_t): int32_t
{
	int32_t ok = 7;
	uintptr_t h = func @h(): int32_t;
	l_1 = START(l_E);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t y = PARAM(l_1, "y", 2);
	uint8_t s = ADD(x, y);
	l_5 = GUARD(l_1, s, h);
	l_E = RETURN(l_5, ok);
}
func @guard_not_u8(uint8_t, uint8_t): int32_t;
func @guard_not_u8(uint8_t, uint8_t): int32_t
{
	int32_t ok = 7;
	uintptr_t h = func @h(): int32_t;
	l_1 = START(l_E);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t y = PARAM(l_1, "y", 2);
	uint8_t s = ADD(x, y);
	l_5 = GUARD_NOT(l_1, s, h);
	l_E = RETURN(l_5, ok);
}
