	uintptr_t f_guard_u8 = func @guard_u8(uint8_t, uint8_t): int32_t;
	l_0 = START(l_end);
	int32_t r0, c0 = CALL/2(l_0, f_guard_u8, a0, b0);
	p0 = CALL/2(c0, fp, fmt, r0);
	int32_t r1, c1 = CALL/2(p0, f_guard_not_u8, a1, b1);
	p1 = CALL/2(c1, fp, fmt, r1);
	int32_t r2, c2 = CALL/2(p1, f_guard_u8, a2, b2);
	p2 = CALL/2(c2, fp, fmt, r2);
	int32_t r3, c3 = CALL/2(p2, f_guard_not_u8, a3, b3);
	p3 = CALL/2(c3, fp, fmt, r3);
	int32_t r4, c4 = CALL/2(p3, f_guard_u8, a4, b4);
	p4 = CALL/2(c4, fp, fmt, r4);
	int32_t r5, c5 = CALL/2(p4, f_guard_not_u8, a5, b5);
	p5 = CALL/2(c5, fp, fmt, r5);
	int32_t r6, c6 = CALL/2(p5, f_guard_i8, a6, b6);
	p6 = CALL/2(c6, fp, fmt, r6);
	int32_t r7, c7 = CALL/2(p6, f_guard_not_i8, a7, b7);
	p7 = CALL/2(c7, fp, fmt, r7);
	int32_t r8, c8 = CALL/2(p7, f_guard_i8, a8, b8);
	p8 = CALL/2(c8, fp, fmt, r8);
	int32_t r9, c9 = CALL/2(p8, f_guard_not_i8, a9, b9);
	p9 = CALL/2(c9, fp, fmt, r9);
	int32_t r10, c10 = CALL/2(p9, f_guard_i8, a10, b10);
	p10 = CALL/2(c10, fp, fmt, r10);
	int32_t r11, c11 = CALL/2(p10, f_guard_not_i8, a11, b11);
	p11 = CALL/2(c11, fp, fmt, r11);
	int32_t r12, c12 = CALL/2(p11, f_guard_u16, a12, b12);
