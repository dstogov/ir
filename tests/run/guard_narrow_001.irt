	int16_t a19 = 3;
	int16_t b19 = 4;
	uintptr_t f_guard_i16 = func @guard_i16(int16_t, int16_t): int32_t;
	uintptr_t f_guard_i8 = func @guard_i8(int8_t, int8_t): int32_t;
	uintptr_t f_guard_not_i16 = func @guard_not_i16(int16_t, int16_t): int32_t;
	uintptr_t f_guard_not_i8 = func @guard_not_i8(int8_t, int8_t): int32_t;
	uintptr_t f_guard_not_u16 = func @guard_not_u16(uint16_t, uint16_t): int32_t;
