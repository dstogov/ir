--TEST--
DIV(NEG(x), c) with x = INT32_MIN
--ARGS--
--run
--CODE--
func div_neg_c(int32_t): int32_t
{
	int32_t c = 10;
	l_1 = START(l_3);
	int32_t x = PARAM(l_1, "x", 1);
	int32_t n = NEG(x);
	int32_t r = DIV(n, c);
	l_3 = RETURN(l_1, r);
}
func main(): int32_t
{
	int32_t c_0 = 0;
	int32_t a = -2147483648;
	int32_t b = 25;
	uintptr_t f = func printf(uintptr_t, ...): int32_t;
	uintptr_t d = func div_neg_c(int32_t): int32_t;
	uintptr_t fmt = "%d %d\n";
	l_1 = START(l_9);
	int32_t r1, l_2 = CALL/1(l_1, d, a);
	int32_t r2, l_3 = CALL/1(l_2, d, b);
	int32_t z, l_4 = CALL/3(l_3, f, fmt, r1, r2);
	l_9 = RETURN(l_4, c_0);
}
--EXPECT--
-214748364 -2
