--TEST--
DIV(NEG(x), c) with x = INT64_MIN
--ARGS--
--run
--CODE--
func div_neg_c(int64_t): int64_t
{
	int64_t c = 10;
	l_1 = START(l_3);
	int64_t x = PARAM(l_1, "x", 1);
	int64_t n = NEG(x);
	int64_t r = DIV(n, c);
	l_3 = RETURN(l_1, r);
}
func main(): int32_t
{
	int32_t c_0 = 0;
	int64_t a = -9223372036854775808;
	uintptr_t f = func printf(uintptr_t, ...): int32_t;
	uintptr_t d = func div_neg_c(int64_t): int64_t;
	uintptr_t fmt = "%lld\n";
	l_1 = START(l_9);
	int64_t r, l_2 = CALL/1(l_1, d, a);
	int32_t z, l_3 = CALL/2(l_2, f, fmt, r);
	l_9 = RETURN(l_3, c_0);
}
--EXPECT--
-922337203685477580
