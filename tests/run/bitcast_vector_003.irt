--TEST--
003: vector BITCAST uint8 round trip
--ARGS--
--run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func vec8_roundtrip(uint8_t): uint32_t;
func vec8_roundtrip(uint8_t): uint32_t
{
	l_1 = START(l_5);
	uint8_t x = PARAM(l_1, "x", 1);
	<uint8_t*1> v = BITCAST(x);
	uint8_t y = BITCAST(v);
	uint32_t ret = ZEXT(y);
	l_5 = RETURN(l_1, ret);
}
func main(void): int32_t
{
	int32_t c_0 = 0;
	uint8_t c_0x7f = 127;
	uintptr_t c_printf = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_fmt = "%u\n";
	uintptr_t c_vec8_roundtrip = func vec8_roundtrip(uint8_t): uint32_t;
	l_1 = START(l_4);
	uint32_t r_1, l_2 = CALL/1(l_1, c_vec8_roundtrip, c_0x7f);
	int32_t r_2, l_3 = CALL/2(l_2, c_printf, c_fmt, r_1);
	l_4 = RETURN(l_3, c_0);
}
--EXPECT--
127
