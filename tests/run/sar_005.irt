--TEST--
SAR 005: shift by var computed from op1
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func sar8(int8_t): int32_t
{
	int8_t c_1 = 7;
	l_1 = START(l_7);
	int8_t d_2 = PARAM(l_1, "arg_1", 1);
	int8_t d_3 = AND(d_2, c_1);
	int8_t d_4 = SAR(d_2, d_3);
	int8_t d_5 = XOR(d_4, d_2);
	int32_t d_6 = SEXT(d_5);
	l_7 = RETURN(l_1, d_6);
}
func sar16(int16_t): int32_t
{
	int16_t c_1 = 15;
	l_1 = START(l_7);
	int16_t d_2 = PARAM(l_1, "arg_1", 1);
	int16_t d_3 = AND(d_2, c_1);
	int16_t d_4 = SAR(d_2, d_3);
	int16_t d_5 = XOR(d_4, d_2);
	int32_t d_6 = SEXT(d_5);
	l_7 = RETURN(l_1, d_6);
}
func main(): int32_t
{
	uintptr_t c_1 = "i8:  %d\ni16: %d\n";
	uintptr_t c_2 = func printf(uintptr_t, ...): int32_t;
	int32_t c_3 = 0;
	int8_t c_4 = -7;
	int16_t c_5 = -174;
	uintptr_t c_6 = func sar8(int8_t): int32_t;
	uintptr_t c_7 = func sar16(int16_t): int32_t;
	l_1 = START(l_5);
	int32_t d_2, l_2 = CALL/1(l_1, c_6, c_4);
	int32_t d_3, l_3 = CALL/1(l_2, c_7, c_5);
	int32_t d_4, l_4 = CALL/3(l_3, c_2, c_1, d_2, d_3);
	l_5 = RETURN(l_4, c_3);
}
--EXPECT--
i8:  5
i16: 134
