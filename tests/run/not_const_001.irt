--TEST--
Boolean NOT of integer constants
--ARGS--
--run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func main(void): int32_t
{
	uintptr_t c_printf = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_fmt = "%d%d%d %d%d %d%d %d%d%d\n";
	int32_t c_i0 = 0;
	int32_t c_i5 = 5;
	int32_t c_im1 = -1;
	uint8_t c_u0 = 0;
	uint8_t c_u255 = 255;
	int64_t c_l0 = 0;
	int64_t c_l32 = 4294967296;
	uintptr_t c_a0 = 0;
	uintptr_t c_a5 = 5;
	int32_t c_ret = 0;
	l_1 = START(l_3);
	bool d_1 = NOT(c_i0);
	bool d_2 = NOT(c_i5);
	bool d_3 = NOT(c_im1);
	bool d_4 = NOT(c_u0);
	bool d_5 = NOT(c_u255);
	bool d_6 = NOT(c_l0);
	bool d_7 = NOT(c_l32);
	bool d_8 = NOT(c_a0);
	bool d_9 = NOT(c_a5);
	bool d_10 = NOT(c_fmt);
	int32_t r_1 = ZEXT(d_1);
	int32_t r_2 = ZEXT(d_2);
	int32_t r_3 = ZEXT(d_3);
	int32_t r_4 = ZEXT(d_4);
	int32_t r_5 = ZEXT(d_5);
	int32_t r_6 = ZEXT(d_6);
	int32_t r_7 = ZEXT(d_7);
	int32_t r_8 = ZEXT(d_8);
	int32_t r_9 = ZEXT(d_9);
	int32_t r_10 = ZEXT(d_10);
	int32_t d_p, l_2 = CALL/11(l_1, c_printf, c_fmt, r_1, r_2, r_3, r_4, r_5, r_6, r_7, r_8, r_9, r_10);
	l_3 = RETURN(l_2, c_ret);
}
--EXPECT--
100 10 10 100
