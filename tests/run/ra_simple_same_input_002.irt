	double a5 = 7.5;
	uintptr_t ff6 = func @f6(double): int32_t;
	double a6 = 7.5;
	l_1 = START(l_r);
	int32_t r0, l_2 = CALL/1(l_1, ff0, a0);
	int32_t r1, l_3 = CALL/1(l_2, ff1, a1);
	int32_t r2, l_4 = CALL/1(l_3, ff2, a2);
	int32_t r3, l_5 = CALL/1(l_4, ff3, a3);
	int32_t r4, l_6 = CALL/1(l_5, ff4, a4);
	int32_t r5, l_7 = CALL/1(l_6, ff5, a5);
	int32_t r6, l_8 = CALL/1(l_7, ff6, a6);
	l_p = CALL/8(l_8, fp, fmt, r0, r1, r2, r3, r4, r5, r6);
	l_r = RETURN(l_p, z);
}
