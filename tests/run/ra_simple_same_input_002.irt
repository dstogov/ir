func @main(): int32_t
{
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d %d %d %d %d %d %d\n";
	int32_t z = 0;
	uintptr_t ff0 = func @f0(int32_t): int32_t;
	int32_t a0 = 7;
	uintptr_t ff1 = func @f1(int32_t): int32_t;
	int32_t a1 = 7;
