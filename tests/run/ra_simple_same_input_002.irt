	l_2 = IF(l_1, b);
	l_3 = IF_TRUE(l_2);
	l_4 = RETURN(l_3, c_1);
	l_5 = IF_FALSE(l_2);
	l_6 = RETURN(l_5, c_2, l_4);
}
