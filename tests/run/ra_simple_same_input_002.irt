--TEST--
Simple register allocator: the same value used as both operands of a fused compare
--ARGS--
-O0 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @f0(int32_t): int32_t;
func @f0(int32_t): int32_t
{
	int32_t c_1 = 1;
	int32_t c_2 = 2;
	l_1 = START(l_6);
	int32_t x = PARAM(l_1, "x", 1);
	bool b = EQ(x, x);
	l_2 = IF(l_1, b);
	l_3 = IF_TRUE(l_2);
	l_4 = RETURN(l_3, c_1);
	l_5 = IF_FALSE(l_2);
	l_6 = RETURN(l_5, c_2, l_4);
}
