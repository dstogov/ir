--TEST--
DIV 007: div float constant by itself
--ARGS--
-O0 --run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func test(void): float
{
	float c_1 = 1912602624;
	l_1 = START(l_2);
	float ret = DIV(c_1, c_1);
	l_2 = RETURN(l_1, ret);
}
func main(void): int32_t
{
	uintptr_t c_1 = func test(void): float;
	uintptr_t c_2 = "0x%x\n";
	uintptr_t c_3 = func printf(uintptr_t, ...): int32_t;
	int32_t c_4 = 0;
	l_1 = START(l_5);
	float d_2, l_2 = CALL/0(l_1, c_1);
	uint32_t d_3 = BITCAST(d_2);
	int32_t d_4, l_4 = CALL/2(l_2, c_3, c_2, d_3);
	l_5 = RETURN(l_4, c_4);
}
--EXPECT--
0x3f800000
