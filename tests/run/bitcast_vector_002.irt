--TEST--
002: vector BITCAST uint16 round trip
--ARGS--
--run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func vec16_roundtrip(uint16_t): uint32_t;
func vec16_roundtrip(uint16_t): uint32_t
{
	l_1 = START(l_5);
	uint16_t x = PARAM(l_1, "x", 1);
	<uint8_t*2> v = BITCAST(x);
	uint16_t y = BITCAST(v);
	uint32_t ret = ZEXT(y);
	l_5 = RETURN(l_1, ret);
}
func main(void): int32_t
{
	int32_t c_0 = 0;
	uint16_t c_0x1234 = 4660;
	uintptr_t c_printf = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_fmt = "%u\n";
	uintptr_t c_vec16_roundtrip = func vec16_roundtrip(uint16_t): uint32_t;
	l_1 = START(l_4);
	uint32_t r_1, l_2 = CALL/1(l_1, c_vec16_roundtrip, c_0x1234);
	int32_t r_2, l_3 = CALL/2(l_2, c_printf, c_fmt, r_1);
	l_4 = RETURN(l_3, c_0);
}
--EXPECT--
4660
