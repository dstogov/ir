--TEST--
CTTZ of narrow integers
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @cttz_u8(uint8_t): int32_t;
func @cttz_u8(uint8_t): int32_t
{
	l_1 = START(l_E);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t c = CTTZ(x);
	int32_t r = ZEXT(c);
	l_E = RETURN(l_1, r);
}
func @cttz_u16(uint16_t): int32_t;
func @cttz_u16(uint16_t): int32_t
{
	l_1 = START(l_E);
	uint16_t x = PARAM(l_1, "x", 1);
	uint16_t c = CTTZ(x);
	int32_t r = ZEXT(c);
	l_E = RETURN(l_1, r);
}
func @main(): int32_t
{
	uintptr_t fp = func @printf(uintptr_t, ...): int32_t;
	uintptr_t fmt = "%d\n";
	int32_t z = 0;
	uint8_t a0 = 0;
	uint8_t a1 = 8;
	uint16_t a2 = 0;
	uint16_t a3 = 256;
	uintptr_t f_cttz_u8 = func @cttz_u8(uint8_t): int32_t;
	uintptr_t f_cttz_u16 = func @cttz_u16(uint16_t): int32_t;
	l_0 = START(l_end);
	int32_t r0, c0 = CALL/1(l_0, f_cttz_u8, a0);
	p0 = CALL/2(c0, fp, fmt, r0);
	int32_t r1, c1 = CALL/1(p0, f_cttz_u8, a1);
	p1 = CALL/2(c1, fp, fmt, r1);
	int32_t r2, c2 = CALL/1(p1, f_cttz_u16, a2);
	p2 = CALL/2(c2, fp, fmt, r2);
	int32_t r3, c3 = CALL/1(p2, f_cttz_u16, a3);
	p3 = CALL/2(c3, fp, fmt, r3);
	l_end = RETURN(p3, z);
}
--EXPECT--
8
3
16
8
