--TEST--
005: floating-point NOT on float parameters
--ARGS--
--run
--CODE--
extern func @putchar(int32_t): int32_t;
func @test(float): int32_t;
func @main(): int32_t
{
	uintptr_t c_1 = func @putchar(int32_t): int32_t;
	uintptr_t c_2 = func @test(float): int32_t;
	int32_t c_3 = 48;
	float c_4 = 0.0;
	float c_5 = -0.0;
	float c_6 = 1.0;
	float c_7 = -1.0;
	float c_8 = nan;
	int32_t c_9 = 0;
	l_1 = START(l_17);
	int32_t d_2, l_2 = CALL/1(l_1, c_2, c_4);
	int32_t d_3 = ADD(d_2, c_3);
	int32_t d_4, l_4 = CALL/1(l_2, c_1, d_3);
	int32_t d_5, l_5 = CALL/1(l_4, c_2, c_5);
	int32_t d_6 = ADD(d_5, c_3);
	int32_t d_7, l_7 = CALL/1(l_5, c_1, d_6);
	int32_t d_8, l_8 = CALL/1(l_7, c_2, c_6);
	int32_t d_9 = ADD(d_8, c_3);
	int32_t d_10, l_10 = CALL/1(l_8, c_1, d_9);
	int32_t d_11, l_11 = CALL/1(l_10, c_2, c_7);
	int32_t d_12 = ADD(d_11, c_3);
	int32_t d_13, l_13 = CALL/1(l_11, c_1, d_12);
	int32_t d_14, l_14 = CALL/1(l_13, c_2, c_8);
	int32_t d_15 = ADD(d_14, c_3);
	int32_t d_16, l_16 = CALL/1(l_14, c_1, d_15);
	l_17 = RETURN(l_16, c_9);
}
func @test(float): int32_t
{
	l_1 = START(l_4);
	float d_2 = PARAM(l_1, "x", 1);
	bool d_3 = NOT(d_2);
	int32_t d_4 = ZEXT(d_3);
	l_4 = RETURN(l_1, d_4);
}
--EXPECT--
11000
