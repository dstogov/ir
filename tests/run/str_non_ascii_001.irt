--TEST--
STR 001: non-ASCII bytes in string constants must not be sign-extended
--ARGS--
--run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @main(): int32_t
{
	uintptr_t c_1 = func @printf(uintptr_t, ...): int32_t;
	uintptr_t c_2 = "%08x\n";
	uintptr_t c_3 = "A\303\251Z";
	int32_t c_4 = 0;
	l_1 = START(l_4);
	uint32_t d_2, l_2 = LOAD(l_1, c_3);
	int32_t d_3, l_3 = CALL/2(l_2, c_1, c_2, d_2);
	l_4 = RETURN(l_3, c_4);
}
--EXPECT--
5aa9c341
