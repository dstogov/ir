--TEST--
A literal outside a fixed ALLOCA must not overflow the final x86-64 displacement
--CODE--
func lit_first(uintptr_t): uint64_t
{
	uintptr_t c_64 = 64;
	uintptr_t c_8 = 8;
	uintptr_t c_d = 2147483647;
	uint64_t c_519 = 519;
	uint64_t c_42 = 42;
	l_1 = START(l_8);
	uintptr_t idx = PARAM(l_1, "idx", 1);
	uintptr_t keep, l_2 = ALLOCA(l_1, c_64);
	uintptr_t target, l_3 = ALLOCA(l_2, c_64);
	l_4 = STORE(l_3, keep, c_519);
	uintptr_t t_8 = ADD(target, c_8);
	l_5 = STORE(l_4, t_8, c_42);
	uintptr_t a1 = ADD(target, c_d);
	uintptr_t a2 = ADD(a1, idx);
	uint64_t v, l_6 = LOAD(l_5, a2);
	uint64_t k, l_7 = LOAD_v(l_6, keep);
	uint64_t r = ADD(v, k);
	l_8 = RETURN(l_7, r);
}
