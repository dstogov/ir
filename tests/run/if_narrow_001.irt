--TEST--
IF on narrow integers with not normalized upper bits (including EQ/NE with 0)
--ARGS--
-O1 --run
--CODE--
extern func @printf(uintptr_t, ...): int32_t;
func @if_if_u8(uint8_t, uint8_t): int32_t;
func @if_if_u8(uint8_t, uint8_t): int32_t
{
	int32_t one = 1;
	int32_t zero = 0;
	uint8_t c0 = 0;
	l_1 = START(l_E);
	uint8_t x = PARAM(l_1, "x", 1);
	uint8_t y = PARAM(l_1, "y", 2);
	uint8_t s = ADD(x, y);
	l_2 = IF(l_1, s);
	l_3 = IF_TRUE(l_2);
	l_4 = IF_FALSE(l_2);
	l_5 = END(l_3);
	l_6 = END(l_4);
	l_7 = MERGE(l_5, l_6);
	int32_t r = PHI(l_7, one, zero);
	l_E = RETURN(l_7, r);
}
