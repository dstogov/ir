--TEST--
Nested loop invariant initialization after an entry predecessor
--ARGS--
--run
--CODE--
{
	int32_t c_1 = 0;
	int32_t c_2 = 128;
	uintptr_t c_3 = "%d\n";
	uintptr_t c_4 = func printf(uintptr_t, ...): int32_t;
	l_1 = START(l_18);
	l_2 = END(l_1);
	l_3 = ENTRY(l_2, 1);
	l_4 = END(l_3);
	l_5 = LOOP_BEGIN/3(l_2, l_4, l_16);
	l_6 = END(l_5);
	l_7 = LOOP_BEGIN(l_6, l_12);
	int32_t d_8 = COPY(c_2, 1);
	int32_t d_9, l_9 = CALL/2(l_7, c_4, c_3, d_8);
	bool d_10 = LT(d_9, c_1);
	l_10 = IF(l_9, d_10);
	l_11 = IF_TRUE(l_10);
	l_12 = LOOP_END(l_11);
	l_13 = IF_FALSE(l_10);
	bool d_14 = EQ(d_9, c_1);
	l_14 = IF(l_13, d_14);
	l_15 = IF_TRUE(l_14);
	l_16 = LOOP_END(l_15);
	l_17 = IF_FALSE(l_14);
	l_18 = RETURN(l_17, c_1);
}
--EXPECT--
128
