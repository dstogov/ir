--TEST--
SHR 006: uint64_t constant shift count 32
--ARGS--
-O1 --run
--CODE--
extern func printf(uintptr_t, ...): int32_t;
func test(uint64_t): int32_t
{
	int32_t c_1 = 32;
	uint64_t c_2 = 2147483648;
	uintptr_t c_3 = "%llx\n";
	uintptr_t c_4 = func printf(uintptr_t, ...): int32_t;
	l_1 = START(l_5);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	uint64_t d_3 = SHR(d_2, c_1);
	bool d_4 = NE(d_3, c_2);
	int32_t d_5 = ZEXT(d_4);
	int32_t d_6, l_6 = CALL/2(l_1, c_4, c_3, d_3);
	l_5 = RETURN(l_6, d_5);
}
func main(): int32_t
{
	uintptr_t c_1 = func test(uint64_t): int32_t;
	uint64_t c_2 = -9223372036854775807;
	l_1 = START(l_3);
	int32_t d_2, l_2 = CALL/1(l_1, c_1, c_2);
	l_3 = RETURN(l_2, d_2);
}
--EXPECT--
80000000
