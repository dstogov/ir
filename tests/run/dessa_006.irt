--TEST--
DESSA 006: a 64-bit copy split into halves must not overwrite a double that is still to be read
--CODE--
func g(double, uint64_t): double
{
	uint64_t c_1 = 65535;
	l_1 = START(l_7);
	double d_2 = PARAM(l_1, "x", 1);
	uint64_t d_3 = PARAM(l_1, "y", 2);
	uint64_t d_4 = AND(d_3, c_1);
	double d_5 = INT2FP(d_4);
	double d_6 = ADD(d_2, d_5);
	l_7 = RETURN(l_1, d_6);
}
func h(uint64_t, double): uint64_t
{
	l_1 = START(l_5);
	uint64_t d_2 = PARAM(l_1, "x", 1);
	double d_3 = PARAM(l_1, "y", 2);
	uint64_t d_4 = ADD(d_2, d_2);
	l_5 = RETURN(l_1, d_4);
}
func test(uint64_t, double, bool): uint64_t
{
	uintptr_t c_1 = func g(double, uint64_t): double;
	uintptr_t c_2 = func h(uint64_t, double): uint64_t;
	uint64_t c_3 = 1311768467463790320;
	uint64_t c_4 = 18364758544493064720;
	uint64_t c_5 = 9223372036854775809;
	l_1 = START(l_25);
	uint64_t d_2 = PARAM(l_1, "p1", 1);
	double d_3 = PARAM(l_1, "p2", 2);
	bool d_4 = PARAM(l_1, "flag", 3);
	l_5 = IF(l_1, d_4);
	l_6 = IF_TRUE(l_5);
	double d_7 = ADD(d_3, d_3);
	uint64_t d_8, l_8 = CALL/2(l_6, c_2, d_2, d_3);
	l_9 = END(l_8);
	l_10 = IF_FALSE(l_5);
	l_11 = END(l_10);
	l_12 = MERGE(l_9, l_11);
	double d_13 = PHI(l_12, d_7, d_3);
	uint64_t d_14 = PHI(l_12, d_2, c_3);
	uint64_t d_15 = PHI(l_12, c_5, c_4);
	double d_16, l_16 = CALL/2(l_12, c_1, d_13, d_2);
	uint64_t d_17 = ADD(d_2, d_14);
	uint64_t d_18 = ADD(d_17, d_15);
	uint64_t d_19 = ADD(d_18, d_2);
	uint64_t d_20 = ADD(d_19, d_2);
	uint64_t d_21 = XOR(d_20, d_2);
	uint64_t d_22 = BITCAST(d_16);
	uint64_t d_23 = ADD(d_21, d_22);
	uint64_t d_24 = ADD(d_23, d_2);
	l_25 = RETURN(l_16, d_24);
}
func main(): int32_t
{
	int32_t c_1 = 0;
	uintptr_t c_2 = func printf(uintptr_t, ...): int32_t;
	uintptr_t c_3 = func test(uint64_t, double, bool): uint64_t;
	uintptr_t c_4 = "%llx\n";
	uint64_t c_5 = 1229782938247303441;
	double c_6 = 2.5;
	bool c_7 = 1;
	l_1 = START(l_4);
	uint64_t d_2, l_2 = CALL/3(l_1, c_3, c_5, c_6, c_7);
	int32_t d_3, l_3 = CALL/2(l_2, c_2, c_4, d_2);
	l_4 = RETURN(l_3, c_1);
}
--EXPECT--
27177c6666666665
