--TEST--
005: Combine MIN/MAX (FP PHI is not combined)
--ARGS--
--save
--CODE--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	l_1 = START(l_12);
	double d_2 = PARAM(l_1, "x", 0);
	double d_3 = PARAM(l_1, "y", 1);
	bool d_4 = LT(d_2, d_3);
	l_5 = IF(l_1, d_4);
	l_6 = IF_TRUE(l_5);
	l_7 = END(l_6);
	l_8 = IF_FALSE(l_5);
	l_9 = END(l_8);
	l_10 = MERGE(l_7, l_9);
	double d_11 = PHI(l_10, d_2, d_3);
	l_12 = RETURN(l_10, d_11);
}
--EXPECT--
{
	uintptr_t c_1 = 0;
	bool c_2 = 0;
	bool c_3 = 1;
	l_1 = START(l_6);
	double d_2 = PARAM(l_1, "x", 0);
	double d_3 = PARAM(l_1, "y", 1);
	bool d_4 = GT(d_3, d_2);
	double d_5 = COND(d_4, d_2, d_3);
	l_6 = RETURN(l_1, d_5);
}
