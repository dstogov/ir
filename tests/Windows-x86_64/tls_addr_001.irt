--TEST--
001: TLS_ADDR
--TARGET--
x86_64-windows
--ARGS--
-S
--CODE--
func thread_pointer(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(-1, 0);
	l_4 = RETURN(l_1, ret);
}
func tls_addr_static(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(-1, 16);
	l_4 = RETURN(l_1, ret);
}
func tls_addr_dynamic0(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(16, 0);
	l_4 = RETURN(l_1, ret);
}
func tls_addr_dynamic(): uintptr_t
{
	l_1 = START(l_4);
	uintptr_t ret = TLS_ADDR(16, 32);
	l_4 = RETURN(l_1, ret);
}
func tls_load_static(): int32_t
{
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(-1, 16);
	int32_t ret, l_2 = LOAD(l_1, addr);
	l_4 = RETURN(l_2, ret);
}
func tls_load_dynamic(): int32_t
{
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(16, 32);
	int32_t ret, l_2 = LOAD(l_1, addr);
	l_4 = RETURN(l_2, ret);
}
func tls_store_static(): void
{
	int32_t val = 42;
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(-1, 16);
	l_2 = STORE(l_1, addr, val);
	l_4 = RETURN(l_2);
}
func tls_store_dynamic(): void
{
	int32_t val = 42;
	l_1 = START(l_4);
	uintptr_t addr = TLS_ADDR(16, 32);
	l_2 = STORE(l_1, addr, val);
	l_4 = RETURN(l_2);
}
--EXPECT--
thread_pointer:
	movq %gs:0x58, %rax
	movq -1(%rax), %rax
	retq

tls_addr_static:
	movq %gs:0x58, %rax
	movq -1(%rax), %rax
	addq $0x10, %rax
	retq

tls_addr_dynamic0:
	movq %gs:0x58, %rax
	movq 0x10(%rax), %rax
	retq

tls_addr_dynamic:
	movq %gs:0x58, %rax
	movq 0x10(%rax), %rax
	addq $0x20, %rax
	retq

tls_load_static:
	movl %gs:0x10, %eax
	retq

tls_load_dynamic:
	movq %gs:0x58, %rax
	movq 0x10(%rax), %rax
	movl 0x20(%rax), %eax
	retq

tls_store_static:
	movl $0x2a, %gs:0x10
	retq

tls_store_dynamic:
	movq %gs:0x58, %rax
	movq 0x10(%rax), %rax
	movl $0x2a, 0x20(%rax)
	retq
