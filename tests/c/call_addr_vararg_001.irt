--TEST--
001: constant function address vararg call emits a typed function pointer
--ARGS--
--emit-c
--CODE--
{
	uintptr_t c_1 = "x=%d\n";
	int32_t c_2 = 7;
	uintptr_t c_3 = func *0x1234(uintptr_t, ...): int32_t;
	l_1 = START(l_5);
	int32_t d_4, l_4 = CALL/2(l_1, c_3, c_1, c_2);
	l_5 = RETURN(l_4, d_4);
}
--EXPECT--
int32_t test(void)
{
	int32_t d_1;
	d_1 = ((int32_t (*)(uintptr_t, ...))0x1234)("x=%d\n", 7);
	return d_1;
}
