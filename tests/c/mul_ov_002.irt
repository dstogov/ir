--TEST--
002: mul_ov function
--ARGS--
--emit-c
--CODE--
{
	uint32_t c = 2;
	l_1 = START(l_2);
	uint32_t x = PARAM(l_1, "x", 1);
	uint32_t ret = MUL_OV(x, c);
	bool ov = OVERFLOW(ret);
	l_2 = RETURN(l_1, ov);
}
--EXPECT--
bool test(uint32_t x)
{
	uint32_t d_1 = x;
	uint32_t d_2;
	bool d_3;
	d_3 = __builtin_umul_overflow(d_1, 2, &d_2);
	return d_3;
}
