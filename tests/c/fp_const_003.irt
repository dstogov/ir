--TEST--
003: Integral floating point constants
--ARGS--
--emit-c
--CODE--
{
	uintptr_t c_1 = func fd(double, double, double): void;
	uintptr_t c_2 = func ff(float): void;
	double c_3 = 0.0;
	double c_4 = 16.0;
	double c_5 = -3.0;
	float c_6 = 2.0;
	l_1 = START(l_4);
	l_2 = CALL/3(l_1, c_1, c_3, c_4, c_5);
	l_3 = CALL/1(l_2, c_2, c_6);
	l_4 = RETURN(l_3);
}
--EXPECT--
void test(void)
{
	fd(0.0, 16.0, -3.0);
	ff(2.0f);
	return;
}
