--TEST--
003: unary, bitwise, shift, rotate and bit-count operations on addresses
--CODE--
{
	l_1 = START(l_3);
	uintptr_t p = PARAM(l_1, "p", 1);
	uintptr_t q = PARAM(l_1, "q", 2);
	uintptr_t d_1 = NEG(p);
	uintptr_t d_2 = NOT(d_1);
	uintptr_t d_3 = OR(d_2, q);
	uintptr_t d_4 = XOR(d_3, q);
	uintptr_t d_5 = DIV(d_4, q);
	uintptr_t d_6 = MOD(d_5, q);
	uintptr_t d_7 = SHL(d_6, q);
	uintptr_t d_8 = SAR(d_7, q);
	uintptr_t d_9 = ROL(d_8, q);
	uintptr_t d_10 = ROR(d_9, q);
	uintptr_t d_11 = BSWAP(d_10);
	uintptr_t d_12 = CTPOP(d_11);
	uintptr_t d_13 = CTLZ(d_12);
	uintptr_t d_14 = CTTZ(d_13);
	uintptr_t d_15 = MIN(d_14, q);
	uintptr_t d_16 = MAX(d_15, p);
	uintptr_t d_17 = ABS(d_16);
	bool d_18 = NOT(d_17);
	uintptr_t d_19 = COND(p, d_17, q);
	uintptr_t d_20 = COND(d_18, d_19, p);
	l_3 = RETURN(l_1, d_20);
}
--EXPECT--
void* test(void* p, void* q)
{
	uintptr_t d_1 = (uintptr_t)p;
	uintptr_t d_2 = (uintptr_t)q;
	uintptr_t d_3;
	uintptr_t d_4;
	uintptr_t d_5;
	uintptr_t d_6;
	uintptr_t d_7;
	uintptr_t d_8;
	uintptr_t d_9;
	uintptr_t d_10;
	uintptr_t d_11;
	uintptr_t d_12;
	uintptr_t d_13;
	uintptr_t d_14;
	uintptr_t d_15;
	uintptr_t d_16;
	uintptr_t d_17;
	uintptr_t d_18;
	uintptr_t d_19;
	bool d_20;
	uintptr_t d_21;
	uintptr_t d_22;
	d_3 = -d_1;
	d_4 = ~d_3;
	d_5 = d_4 | d_2;
	d_6 = d_5 ^ d_2;
	d_7 = d_6 / d_2;
	d_8 = d_7 % d_2;
	d_9 = d_8 << d_2;
	d_10 = (int64_t)d_9 >> (int64_t)d_2;
	d_11 = (d_10 << (d_2 & 63)) | (d_10 >> (-d_2 & 63));
	d_12 = (d_11 >> (d_2 & 63)) | (d_11 << (-d_2 & 63));
	d_13 = __builtin_bswap64(d_12);
	d_14 = __builtin_popcountll(d_13);
	d_15 = __builtin_clzll(d_14);
	d_16 = __builtin_ctzll(d_15);
	d_17 = d_16 < d_2 ? d_16 : d_2;
	d_18 = d_17 > d_1 ? d_17 : d_1;
	d_19 = d_18;
	d_20 = !d_19;
	d_21 = d_1 ? d_19 : d_2;
	d_22 = d_20 ? d_21 : d_1;
	return (void*)d_22;
}
