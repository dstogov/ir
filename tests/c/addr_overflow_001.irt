--TEST--
001: ADD_OV on addresses
--CODE--
{
	l_1 = START(l_3);
	uintptr_t p = PARAM(l_1, "p", 1);
	uintptr_t q = PARAM(l_1, "q", 2);
	uintptr_t d_1 = ADD_OV(p, q);
	bool d_2 = OVERFLOW(d_1);
	uintptr_t d_3 = COND(d_2, q, d_1);
	l_3 = RETURN(l_1, d_3);
}
--EXPECT--
void* test(void* p, void* q)
{
	uintptr_t d_1 = (uintptr_t)p;
	uintptr_t d_2 = (uintptr_t)q;
	uintptr_t d_3;
	bool d_4;
	uintptr_t d_5;
	d_4 = __builtin_add_overflow(d_2, d_1, &d_3);
	d_5 = d_4 ? d_2 : d_3;
	return (void*)d_5;
}
