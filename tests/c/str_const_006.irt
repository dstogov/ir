--TEST--
006: string constants moved into a PHI at -O0 are cast to uintptr_t
--ARGS--
-O0 --emit-c
--CODE--
{
	uintptr_t c_1 = "yes";
	uintptr_t c_2 = "no";
	l_1 = START(l_9);
	bool d_2 = PARAM(l_1, "b", 1);
	l_3 = IF(l_1, d_2);
	l_4 = IF_TRUE(l_3);
	l_5 = END(l_4);
	l_6 = IF_FALSE(l_3);
	l_7 = END(l_6);
	l_8 = MERGE(l_5, l_7);
	uintptr_t d_8 = PHI(l_8, c_1, c_2);
	l_9 = RETURN(l_8, d_8);
}
--EXPECT--
uintptr_t test(bool b)
{
	bool d_1 = b;
	uintptr_t d_2;
	if (!d_1) goto bb3;
	d_2 = (uintptr_t)"yes";
	goto bb4;
bb3:
	d_2 = (uintptr_t)"no";
bb4:
	return d_2;
}
