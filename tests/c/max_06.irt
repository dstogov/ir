--TEST--
006: max function
--ARGS--
--emit-c
--CODE--
{
	l_1 = START(l_4);
	double x = PARAM(l_1, "x", 1);
	double y = PARAM(l_1, "y", 2);
	double ret = MAX(x, y);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
double test(double x, double y)
{
	double d_1 = x;
	double d_2 = y;
	double d_3;
	d_3 = __builtin_fmax(d_2, d_1);
	return d_3;
}
