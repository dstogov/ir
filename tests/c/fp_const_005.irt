--TEST--
005: Floating point vector constants
--ARGS--
--emit-c
--CODE--
{
	<double*2> c_1 = {-inf, -0.0};
	<float*4> c_2 = {nan, -0.0, 3.0, 1.5};
	l_1 = START(l_4);
	uintptr_t p = PARAM(l_1, "p", 1);
	uintptr_t q = PARAM(l_1, "q", 2);
	l_2 = STORE(l_1, p, c_1);
	l_3 = STORE(l_2, q, c_2);
	l_4 = RETURN(l_3);
}
--EXPECT--
void test(uintptr_t p, uintptr_t q)
{
	uintptr_t d_1 = p;
	uintptr_t d_2 = q;
	*((double __attribute__((__vector_size__(16)))*)d_1) = (double __attribute__((__vector_size__(16)))){-__builtin_inf(), -0.0};
	*((float __attribute__((__vector_size__(16)))*)d_2) = (float __attribute__((__vector_size__(16)))){__builtin_nanf(""), -0.0f, 3.0f, 1.5f};
	return;
}
