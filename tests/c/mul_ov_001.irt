--TEST--
001: mul_ov function
--ARGS--
--emit-c
--CODE--
{
	int32_t c = 2;
	l_1 = START(l_2);
	int32_t x = PARAM(l_1, "x", 1);
	int32_t ret = MUL_OV(x, c);
	bool ov = OVERFLOW(ret);
	l_2 = RETURN(l_1, ov);
}
--EXPECT--
bool test(int32_t x)
{
	int32_t d_1 = x;
	int32_t d_2;
	bool d_3;
	d_3 = __builtin_smul_overflow(d_1, 2, &d_2);
	return d_3;
}
