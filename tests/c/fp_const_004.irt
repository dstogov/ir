--TEST--
004: Floating point constants that need a hex literal
--ARGS--
--emit-c
--CODE--
{
	uintptr_t c_1 = func fd(double, double, double): void;
	uintptr_t c_2 = func ff(float, float, float): void;
	double c_3 = 0.1;
	double c_4 = 1e20;
	double c_5 = 0.30000000000000004;
	float c_6 = 13.4;
	float c_7 = 1e10;
	float c_8 = 16777215.0;
	l_1 = START(l_4);
	l_2 = CALL/3(l_1, c_1, c_3, c_4, c_5);
	l_3 = CALL/3(l_2, c_2, c_6, c_7, c_8);
	l_4 = RETURN(l_3);
}
--EXPECT--
void test(void)
{
	fd(0.1, 1e+20, 0x1.3333333333334p-2);
	ff(13.4f, 1e+10f, 0x1.fffffep+23f);
	return;
}
