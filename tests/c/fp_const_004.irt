--TEST--
004: Floating point constants that need a hex literal
--ARGS--
--emit-c
--CODE--
{
	uintptr_t c_1 = func fd(double, double): void;
	uintptr_t c_2 = func ff(float): void;
	double c_3 = 0.1;
	double c_4 = 1e20;
	float c_5 = 13.4;
	l_1 = START(l_4);
	l_2 = CALL/2(l_1, c_1, c_3, c_4);
	l_3 = CALL/1(l_2, c_2, c_5);
	l_4 = RETURN(l_3);
}
--EXPECT--
void test(void)
{
	fd(0.1, 1e+20);
	ff(0x1.acccccp+3);
	return;
}
