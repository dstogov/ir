--TEST--
001: string constants are emitted as uintptr_t
--CODE--
{
	uintptr_t c_1 = "abc";
	l_1 = START(l_3);
	uintptr_t p = PARAM(l_1, "p", 1);
	l_2 = STORE(l_1, p, c_1);
	l_3 = RETURN(l_2, c_1);
}
--EXPECT--
uintptr_t test(uintptr_t p)
{
	uintptr_t d_1 = p;
	*((uintptr_t*)d_1) = (uintptr_t)"abc";
	return (uintptr_t)"abc";
}
