--TEST--
002: comparisons and conversions of addresses go through uintptr_t
--CODE--
{
	l_1 = START(l_3);
	uintptr_t p = PARAM(l_1, "p", 1);
	uintptr_t q = PARAM(l_1, "q", 2);
	bool d_3 = ULT(p, q);
	bool d_4 = EQ(p, q);
	bool d_5 = AND(d_3, d_4);
	uint32_t d_6 = TRUNC(p);
	int64_t d_7 = BITCAST(q);
	uintptr_t d_8 = COND(d_5, p, q);
	l_2 = STORE(l_1, d_8, d_6);
	l_3 = RETURN(l_2, d_7);
}
--EXPECT--
int64_t test(void* p, void* q)
{
	uintptr_t d_1 = (uintptr_t)p;
	uintptr_t d_2 = (uintptr_t)q;
	bool d_3;
	bool d_4;
	bool d_5;
	uint32_t d_6;
	int64_t d_7;
	uintptr_t d_8;
	d_3 = d_2 > d_1;
	d_4 = d_2 == d_1;
	d_5 = d_4 && d_3;
	d_6 = (uint32_t)(uint64_t)d_1;
	d_7 = d_2;
	d_8 = d_5 ? d_1 : d_2;
	*((uint32_t*)d_8) = d_6;
	return d_7;
}
