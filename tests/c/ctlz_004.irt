--TEST--
004: CTLZ/CTTZ/CTPOP with a result narrower or wider than the operand
--ARGS--
--emit-c
--CODE--
{
	l_1 = START(l_11);
	int64_t x = PARAM(l_1, "x", 1);
	int16_t y = PARAM(l_1, "y", 2);
	int32_t a = CTLZ(x);
	int32_t b = CTTZ(x);
	int32_t c = CTPOP(x);
	int8_t d = CTLZ(y);
	int32_t e = SEXT(d);
	int32_t w = CTLZ(y);
	int32_t r1 = ADD(a, b);
	int32_t r2 = ADD(r1, c);
	int32_t r3 = ADD(r2, e);
	int32_t r4 = ADD(r3, w);
	l_11 = RETURN(l_1, r4);
}
--EXPECT--
int32_t test(int64_t x, int16_t y)
{
	int64_t d_1 = x;
	int16_t d_2 = y;
	int32_t d_3;
	int32_t d_4;
	int32_t d_5;
	int8_t d_6;
	int32_t d_7;
	int32_t d_8;
	int32_t d_9;
	int32_t d_10;
	int32_t d_11;
	int32_t d_12;
	d_3 = __builtin_clzll((uint64_t)d_1);
	d_4 = __builtin_ctzll((uint64_t)d_1);
	d_5 = __builtin_popcountll((uint64_t)d_1);
	d_6 = __builtin_clz((uint16_t)d_2) - 16;
	d_7 = (int32_t)(int8_t)d_6;
	d_8 = __builtin_clz((uint16_t)d_2) - 16;
	d_9 = d_4 + d_3;
	d_10 = d_9 + d_5;
	d_11 = d_10 + d_7;
	d_12 = d_11 + d_8;
	return d_12;
}
