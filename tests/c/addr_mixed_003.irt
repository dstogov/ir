--TEST--
003: PHI move of uint64_t into an address at -O0
--ARGS--
-O0 --emit-c
--CODE--
{
	uint64_t c_1 = 1;
	uintptr_t c_2 = 0x8;
	l_1 = START(l_9);
	uintptr_t p = PARAM(l_1, "p", 1);
	uint64_t n = PARAM(l_1, "n", 2);
	bool b = PARAM(l_1, "b", 3);
	l_3 = IF(l_1, b);
	l_4 = IF_TRUE(l_3);
	uint64_t d_5 = ADD(n, c_1);
	l_5 = END(l_4);
	l_6 = IF_FALSE(l_3);
	uintptr_t d_6 = ADD(p, c_2);
	l_7 = END(l_6);
	l_8 = MERGE(l_5, l_7);
	uintptr_t d_7 = PHI(l_8, d_5, d_6);
	l_9 = RETURN(l_8, d_7);
}
--EXPECT--
void* test(void* p, uint64_t n, bool b)
{
	uintptr_t d_1 = (uintptr_t)p;
	uint64_t d_2 = n;
	bool d_3 = b;
	uint64_t d_4;
	uintptr_t d_5;
	uintptr_t d_6;
	if (!d_3) goto bb3;
	d_4 = d_2 + 1;
	d_6 = d_4;
	goto bb4;
bb3:
	d_5 = d_1 + 0x8;
	d_6 = d_5;
bb4:
	return (void*)d_6;
}
