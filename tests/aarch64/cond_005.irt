--TEST--
005: COND(uint8_t, I, I) tests only the low 8 bits
--CODE--
{
	l_1 = START(ret);
	uint8_t x = PARAM(l_1, "x", 1);
	int32_t y = PARAM(l_1, "y", 2);
	int32_t z = PARAM(l_1, "z", 3);
	int32_t val = COND(x, y, z);
	ret = RETURN(l_1, val);
}
--EXPECT--
test:
	tst w0, #0xff
	csel w0, w1, w2, ne
	ret
