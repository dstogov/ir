--TEST--
016: type conversion BITCAST int-fp 64-bit round trip
--TARGET--
aarch64
--ARGS--
-S -O0
--CODE--
{
	l_1 = START(l_4);
	uint64_t x = PARAM(l_1, "x", 1);
	double d = BITCAST(x);
	uint64_t y = BITCAST(d);
	l_4 = RETURN(l_1, y);
}
--EXPECT--
test:
	sub sp, sp, #0x20
	str x0, [sp]
	ldr d0, [sp]
	str d0, [sp, #8]
	ldr x0, [sp, #8]
	str x0, [sp, #0x10]
	ldr x0, [sp, #0x10]
	add sp, sp, #0x20
	ret
