--TEST--
019: type conversion BITCAST uint64 to vector
--TARGET--
aarch64
--ARGS--
-S -O0
--CODE--
{
	l_1 = START(l_4);
	uint64_t x = PARAM(l_1, "x", 1);
	<int32_t*2> ret = BITCAST(x);
	l_4 = RETURN(l_1, ret);
}
--EXPECT--
test:
	sub sp, sp, #0x10
	str x0, [sp]
	ldr d0, [sp]
	str d0, [sp, #8]
	ldr d0, [sp, #8]
	add sp, sp, #0x10
	ret
