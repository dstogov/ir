--TEST--
001: compare of narrow integers (the second operand is extended by CMP)
--TARGET--
aarch64
--ARGS--
-S
--CODE--
{
	uint16_t c1 = 1;
	uint16_t c2 = 2;
	l_1 = START(l_4);
	uint16_t x = PARAM(l_1, "x", 1);
	uint16_t y = PARAM(l_1, "y", 2);
	uint16_t a = ADD(x, c1);
	uint16_t b = ADD(a, c2);
	bool e = LT(y, b);
	l_4 = RETURN(l_1, e);
}
--EXPECT--
test:
	add w0, w0, #3
	uxth w0, w0
	cmp w0, w1, uxth
	cset w0, gt
	ret
