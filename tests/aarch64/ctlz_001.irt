--TEST--
001: ZEXT of a 16-bit CTLZ needs no extension
--TARGET--
aarch64
--ARGS--
-S
--CODE--
{
	int32_t c_1 = 48;
	l_1 = START(l_6);
	uint16_t x = PARAM(l_1, "x", 1);
	uint64_t ext = ZEXT(x);
	int32_t clz = CTLZ(ext);
	int32_t ret = SUB(clz, c_1);
	l_6 = RETURN(l_1, ret);
}
--EXPECT--
test:
	and w0, w0, #0xffff
	clz w0, w0
	sub w0, w0, #0x10
	ret

