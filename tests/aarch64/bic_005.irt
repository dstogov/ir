--TEST--
005: AND(NOT(x), CONST) 64-bit, constant is not a logical immediate
--TARGET--
aarch64
--ARGS--
-S
--CODE--
{
	l_1 = START(l_4);
	int64_t x = PARAM(l_1, "x", 1);
	int64_t c = 0x12345678;
	int64_t n = NOT(x);
	int64_t r = AND(n, c);
	l_4 = RETURN(l_1, r);
}
--EXPECT--
test:
	movz x1, #0x5678
	movk x1, #0x1234, lsl #16
	bic x0, x1, x0
	ret
