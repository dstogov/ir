--TEST--
006: AND(NOT(x), CONST) 32-bit, constant is not a logical immediate
--TARGET--
aarch64
--ARGS--
-S
--CODE--
{
	l_1 = START(l_4);
	int32_t x = PARAM(l_1, "x", 1);
	int32_t c = 0x12345;
	int32_t n = NOT(x);
	int32_t r = AND(n, c);
	l_4 = RETURN(l_1, r);
}
--EXPECT--
test:
	movz w1, #0x2345
	movk w1, #0x1, lsl #16
	bic w0, w1, w0
	ret
