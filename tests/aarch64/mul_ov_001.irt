--TEST--
001: mul_ov function
--TARGET--
aarch64
--ARGS--
-S
--CODE--
{
	int32_t c = 2;
	l_1 = START(l_2);
	int32_t x = PARAM(l_1, "x", 1);
	int32_t ret = MUL_OV(x, c);
	bool ov = OVERFLOW(ret);
	l_2 = RETURN(l_1, ov);
}
--EXPECT--
test:
	movz w1, #0x2
	smull x0, w0, w1
	cmp x0, w0, sxtw
	cset w0, ne
	ret
